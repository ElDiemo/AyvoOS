{
  "name": "@ayvo/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API contracts (Zod schemas and inferred types) for AYVO OS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ayvo/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
