# AYVO OS — private DNS for the DEV preview (ADR 0026), the target of Tailscale split DNS for
# {$DEV_DOMAIN} only. Authoritative for that one name; never a resolver: every other name is
# refused (no recursion, no forwarding, no upstream). Listens on 1053 inside the container;
# Docker publishes it as :53 on the server's Tailscale IPv4 address only.

{$DEV_DOMAIN}:1053 {
	# The name itself: A = the Tailscale IPv4 address; any other type: NOERROR without an answer
	# (never NXDOMAIN, which resolvers would cache for the A record too). Below it: NXDOMAIN.
	template IN A {$DEV_DOMAIN} {
		match "^{$DEV_DOMAIN}[.]$"
		answer "{{ .Name }} 60 IN A {$DEV_TAILNET_IPV4}"
		fallthrough
	}
	template ANY ANY {$DEV_DOMAIN} {
		match "^{$DEV_DOMAIN}[.]$"
		rcode NOERROR
		fallthrough
	}
	template ANY ANY {$DEV_DOMAIN} {
		rcode NXDOMAIN
	}
	errors
}

.:1053 {
	acl {
		block
	}
	errors
}
