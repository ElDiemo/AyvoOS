# AYVO OS — Caddy reverse proxy for the DEV preview (ADR 0013, ADR 0026, ADR 0030).
# Values come from the server-only env file via deploy/dev/compose.yml; none are committed.
#
# Tailnet only (ADR 0026): HTTPS is published only on the server's Tailscale IPv4 address, and
# every request is additionally checked here against the real TCP peer address (remote_ip — never
# a forwarded header). The only public exception is IPv4 :80 for ACME HTTP-01 challenges.
{
	# ACME account contact for automatic TLS certificates.
	email {$ACME_EMAIL}
}

(tailnet) {
	# Tailscale's IPv4 range (and the server's own tailnet address for local deploy checks).
	# Reaching this check at all needs the tailnet: ports are bound to the tailnet address.
	@outside not remote_ip 100.64.0.0/10
}

(robots) {
	# Set immediately (not deferred), including application authentication errors.
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	header -Server
}

{$DEV_DOMAIN} {
	# Certificates only via HTTP-01 on public IPv4 :80 (port 443 is not public any more).
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	import robots
	import tailnet

	# Outside the tailnet: close the connection before the application answers.
	handle @outside {
		abort
	}

	handle {
		# Network access requires the tailnet. WorkOS sessions / agent tokens remain mandatory
		# on their protected application routes; no extra shared Basic Auth password (ADR 0030).
		# Same-origin API: /api and /api/* go to NestJS with the path forwarded UNCHANGED (no
		# handle_path, no rewrite). NestJS serves all routes under the /api global prefix.
		@api path /api /api/*
		handle @api {
			reverse_proxy api:4000 {
				header_down -X-Powered-By
			}
		}

		# Everything else is the Next.js app.
		handle {
			reverse_proxy web:3000 {
				header_down -X-Powered-By
			}
		}
	}
}

# The marketing site's DEV preview (ADR 0040): the same name and certificate on :8443, published
# only on the tailnet address, the same real-peer check. Only GET/HEAD reach the static container.
https://{$DEV_DOMAIN}:8443 {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	import tailnet

	handle @outside {
		abort
	}

	@read method GET HEAD
	handle @read {
		reverse_proxy marketing:8080 {
			header_up -Cookie
			header_up -Authorization
			@unavailable status 5xx
			handle_response @unavailable {
				respond "Marketing preview is not deployed (scripts/deploy-marketing-dev.sh)." 503
			}
		}
	}
	handle {
		header Allow "GET, HEAD"
		respond 405
	}
}

# Plain HTTP (public IPv4 :80, tailnet :80). Caddy answers its own ACME HTTP-01 challenges before
# these routes. Besides that, the public sees only the (normally empty) challenge directory used by
# scripts/verify-dev-acme.sh; the tailnet is redirected to HTTPS; everything else is aborted.
http://{$DEV_DOMAIN} {
	import robots
	import tailnet

	handle /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}
	handle @outside {
		abort
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# Any other host name or a bare IP address: nothing.
http:// {
	abort
}
