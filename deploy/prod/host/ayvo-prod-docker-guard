#!/bin/sh
# AYVO OS — PROD host guard for published Docker ports (doc 036, as ADR 0026 for DEV). Installed
# by install.sh as /usr/local/sbin/ayvo-prod-docker-guard, run by ayvo-prod-docker-guard.service.
#
# Docker publishes ports with its own iptables rules, bypassing UFW. This guard sits first in
# Docker's DOCKER-USER chain, for IPv4 AND IPv6, and drops every NEW connection that enters
# through the public interface towards a container — except IPv4 TCP port 80 (ACME HTTP-01; Caddy
# answers nothing else there) and IPv4 TCP port 443 of the server's public address (the public QR
# edge, ADR 0035; new connections limited per source address). IPv6 has no exception at all. Replies to the containers' own
# outbound connections (ACME, WorkOS, S3) pass. tailscale0 is not touched: who may use the
# tailnet is the Tailscale access policy's decision. SSH and UFW are not touched.
#
#   ayvo-prod-docker-guard apply | remove | status
set -eu

CHAIN=AYVO-PROD-GUARD
# New public QR connections per source address (doc 037): above this rate they are dropped.
QR_RATE=${AYVO_QR_CONN_RATE:-20/second}
QR_BURST=${AYVO_QR_CONN_BURST:-60}
ext_if() {
  ip -4 route show default | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }'
}

remove_family() {
  ipt=$1
  while $ipt -S DOCKER-USER 2>/dev/null | grep -q -- "-j $CHAIN"; do
    rule=$($ipt -S DOCKER-USER | grep -m1 -- "-j $CHAIN" | sed 's/^-A /-D /')
    # shellcheck disable=SC2086 # the rule is re-split into its arguments on purpose
    $ipt $rule
  done
  $ipt -F "$CHAIN" 2>/dev/null || true
  $ipt -X "$CHAIN" 2>/dev/null || true
}

public_ipv4() {
  ip -4 -o addr show dev "$1" scope global | awk '{ sub(/\/.*/, "", $4); print $4; exit }'
}

apply_family() {
  ipt=$1 family=$2 ext=$3 pub=${4:-}
  $ipt -N DOCKER-USER 2>/dev/null || true
  remove_family "$ipt"
  $ipt -N "$CHAIN"
  $ipt -A "$CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
  if [ "$family" = 4 ]; then
    $ipt -A "$CHAIN" -p tcp -m conntrack --ctstate DNAT --ctorigdstport 80 -j RETURN
    $ipt -A "$CHAIN" -p tcp -m conntrack --ctstate DNAT --ctorigdst "$pub" --ctorigdstport 443 \
      -m hashlimit --hashlimit-mode srcip --hashlimit-above "$QR_RATE" --hashlimit-burst "$QR_BURST" \
      --hashlimit-name ayvo-prod-qr -j DROP
    $ipt -A "$CHAIN" -p tcp -m conntrack --ctstate DNAT --ctorigdst "$pub" --ctorigdstport 443 -j RETURN
  fi
  $ipt -A "$CHAIN" -j DROP
  $ipt -I DOCKER-USER 1 -i "$ext" -j "$CHAIN"
}

case ${1:-} in
  apply)
    ext=$(ext_if)
    [ -n "$ext" ] || {
      echo "ayvo-prod-docker-guard: no IPv4 default route, cannot find the public interface" >&2
      exit 1
    }
    [ "$ext" != tailscale0 ] || {
      echo "ayvo-prod-docker-guard: the default route uses tailscale0 (exit node?) — refusing" >&2
      exit 1
    }
    pub=$(public_ipv4 "$ext")
    [ -n "$pub" ] || {
      echo "ayvo-prod-docker-guard: no public IPv4 address on $ext" >&2
      exit 1
    }
    apply_family iptables 4 "$ext" "$pub"
    apply_family ip6tables 6 "$ext"
    echo "ayvo-prod-docker-guard: applied on $ext (IPv4 + IPv6; public QR edge $pub:443)"
    ;;
  remove)
    remove_family iptables
    remove_family ip6tables
    echo "ayvo-prod-docker-guard: removed"
    ;;
  status)
    for ipt in iptables ip6tables; do
      echo "== $ipt"
      $ipt -S DOCKER-USER 2>/dev/null | grep -- "-j $CHAIN" || echo "(no jump)"
      $ipt -S "$CHAIN" 2>/dev/null || echo "(no chain)"
    done
    ;;
  *)
    echo "usage: $0 apply|remove|status" >&2
    exit 2
    ;;
esac
