# AYVO OS — PRODUCTION server-only env file: /opt/ayvo/secrets/prod.env (owner ayvo, mode 600).
# Key NAMES only — every value is set by the owner on AyvoOS-PROD and never leaves it (doc 036 §4).
# Never copy anything from DEV. `scripts/deploy-prod.sh --check` reports missing keys by name.

# Database of the production Compose project (a new, empty database; doc 036 §6).
POSTGRES_USER=ayvo
POSTGRES_DB=ayvo_prod
# Generate on the server, e.g.: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
POSTGRES_PASSWORD=

# ACME account contact for the TLS certificate of os.ayvo.co.
ACME_EMAIL=

# Labels (ADR 0014, doc 016): the production QR base URL (required).
PUBLIC_QR_BASE_URL=
# The PHYSICALLY VALIDATED QR size and error correction: optional, both or neither, no default.
# Leave them unset until the recorded result of the physical print/scan test (doc 036 §8) —
# never estimated, never DEV's. Unset: the application runs; only creating and printing our QR
# labels is refused (ADR 0034).
# LABEL_QR_MIN_SIZE_MM=
# LABEL_QR_ERROR_CORRECTION=

# Optional: only if carrier credentials will ever be entered in production (ADR 0027). Once set,
# keep a copy with the other secrets: encrypted credentials are unreadable without it.
# CARRIER_CREDENTIALS_KEY=

# The other files, also mode 600 in /opt/ayvo/secrets (doc 036 §4):
#   prod-auth.env  AUTH_ENCRYPTION_KEY, AUTH_SMTP_HOST/PORT/USER/PASSWORD, AUTH_MAIL_FROM
#                  Compose reads this file as RAW: literal KEY=value, no export/quoting/expansion.
#                  Generate an independent auth key on PROD and keep its offline backup.
#   prod-s3.env      AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY   (the APPLICATION identity)
#   prod-s3-backup.env  AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (the BACKUP identity, doc 035 —
#                    never given to the application)
# Old WorkOS secret files are not read by this release. Preserve them for a controlled rollback
# until native authentication has been accepted; do not revoke the old key during deployment.
