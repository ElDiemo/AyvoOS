/// One row per successful mutating request. Same request id + same payload → stored result;
/// different payload → conflict. DB: insert-only except setting `result` once (NULL → value).
model OperationRequest {
  itemWeights        ItemReferenceWeight[]
  productWeights     ProductReferenceWeight[]
  tareWeights        CrateTypeTareWeight[]
  crateDimensions    CrateTypeDimension[]
  hotels             Hotel[]
  orders             Order[]
  allocations        OrderCrateAllocation[]   @relation("AllocateOperation")
  allocationReleases OrderCrateAllocation[]   @relation("AllocationReleaseOperation")
  orderEvents        OrderEvent[]
  bottleEvents       BottleEvent[]            @relation("BottleEventOperation")
  labelApprovals     ProductLabelApproval[]   @relation("ApproveOperation")
  labelRevocations   ProductLabelApproval[]   @relation("RevokeOperation")
  cyclesOpened       CrateCycle[]             @relation("CycleOpenOperation")
  assignments        CrateAssignment[]        @relation("AssignOperation")
  releases           CrateAssignment[]        @relation("ReleaseOperation")
  bindings           BottleProductBinding[]
  requestId          String                   @id @map("request_id") @db.Uuid
  kind               OperationKind
  payloadSha256      String                   @map("payload_sha256") @db.Char(64)
  result             Json?
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  catalogComponents        CatalogComponent[]
  crateTypes               CrateType[]
  products                 Product[]
  recipeVersions           RecipeVersion[]
  recipeRevisions          RecipeRevision[]
  crateRegistrations       CrateRegistration[]
  crateLabelPrintJobs      CrateLabelPrintJob[]
  crateEvents              CrateEvent[]
  workstations             Workstation[]
  workstationEvents        WorkstationEvent[]
  workstationSessionEvents WorkstationSessionEvent[]

  shipments       Shipment[]               @relation("ShipmentOperation")
  parcelWeighings ShipmentParcelWeighing[] @relation("ParcelWeighOperation")
  carrierRequests ShipmentCarrierRequest[] @relation("CarrierRequestOperation")
  printRequests   PrintRequest[]           @relation("PrintRequestOperation")

  @@map("operation_requests")
}

// ---------------------------------------------------------------------------------------------
// identity module — users, external identities, roles, permissions, scopes, sessions, audit
// (Milestone 2C, ADR 0022, doc 021). Authentication is delegated to an external OIDC provider;
// authorization is evaluated from these tables on every request.
// ---------------------------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

/// An AYVO user. Never deleted; deactivation revokes access immediately.
/// DB: email lower-case and unique; deactivation fields all-or-none; DELETE rejected.
model User {
  nativeCredential     NativeCredential?
  nativeTokens         NativeAuthToken[]
  nativeChallenges     NativeAuthChallenge[]
  nativeRecoveryCodes  NativeRecoveryCode[]
  employeeCard         EmployeeCard?
  employeeCardPhotos   EmployeeCardPhoto[]
  itemWeights          ItemReferenceWeight[]
  productWeights       ProductReferenceWeight[]
  tareWeights          CrateTypeTareWeight[]
  crateDimensions      CrateTypeDimension[]
  hotelsCreated        Hotel[]                  @relation("HotelCreatedBy")
  ordersCreated        Order[]                  @relation("OrderCreatedBy")
  supplyPlansCreated   SupplyPlan[]             @relation("SupplyPlanCreatedBy")
  supplyPlansUpdated   SupplyPlan[]             @relation("SupplyPlanUpdatedBy")
  supplyPlansActivated SupplyPlan[]             @relation("SupplyPlanActivatedBy")
  ordersCompleted      Order[]                  @relation("OrderCompletedBy")
  ordersCancelled      Order[]                  @relation("OrderCancelledBy")
  allocationsMade      OrderCrateAllocation[]   @relation("AllocatedBy")
  allocationsRelease   OrderCrateAllocation[]   @relation("AllocationReleasedBy")
  orderEvents          OrderEvent[]
  labelApprovals       ProductLabelApproval[]   @relation("ApprovalBy")
  labelRevocations     ProductLabelApproval[]   @relation("ApprovalRevokedBy")
  cyclesOpened         CrateCycle[]             @relation("CycleOpenedBy")
  cyclesAborted        CrateCycle[]             @relation("CycleAbortedBy")
  assignmentsMade      CrateAssignment[]        @relation("AssignedBy")
  assignmentsReleased  CrateAssignment[]        @relation("ReleasedBy")
  id                   String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                String                   @unique
  displayName          String                   @map("display_name")
  status               UserStatus               @default(ACTIVE)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  /// NULL only for the bootstrap administrator.
  createdBy            String?                  @map("created_by") @db.Uuid
  deactivatedAt        DateTime?                @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy        String?                  @map("deactivated_by") @db.Uuid
  deactivationReason   String?                  @map("deactivation_reason")
  lastLoginAt          DateTime?                @map("last_login_at") @db.Timestamptz(3)

  createdByUser             User?                     @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdUsers              User[]                    @relation("UserCreatedBy")
  deactivatedByUser         User?                     @relation("UserDeactivatedBy", fields: [deactivatedBy], references: [id], onDelete: Restrict)
  deactivatedUsers          User[]                    @relation("UserDeactivatedBy")
  identities                UserIdentity[]
  roles                     UserRole[]                @relation("UserRoles")
  rolesGranted              UserRole[]                @relation("RoleGrantedBy")
  rolesRevoked              UserRole[]                @relation("RoleRevokedBy")
  scopes                    UserScope[]               @relation("UserScopes")
  scopesGranted             UserScope[]               @relation("ScopeGrantedBy")
  scopesRevoked             UserScope[]               @relation("ScopeRevokedBy")
  sessions                  UserSession[]
  bootstrap                 IdentityBootstrap?
  rolesCreated              Role[]                    @relation("RoleCreatedBy")
  rolesUpdated              Role[]                    @relation("RoleUpdatedBy")
  sitesCreated              Site[]                    @relation("SiteCreatedBy")
  invitations               UserInvitation[]          @relation("UserInvitations")
  invitationsSent           UserInvitation[]          @relation("InvitationCreatedBy")
  invitationsRevoked        UserInvitation[]          @relation("InvitationRevokedBy")
  sitesUpdated              Site[]                    @relation("SiteUpdatedBy")
  componentsCreated         CatalogComponent[]
  crateTypesCreated         CrateType[]
  productsCreated           Product[]                 @relation("ProductCreatedBy")
  productsArchived          Product[]                 @relation("ProductArchivedBy")
  recipesCreated            RecipeVersion[]           @relation("RecipeCreatedBy")
  recipesActivated          RecipeVersion[]           @relation("RecipeActivatedBy")
  recipesArchived           RecipeVersion[]           @relation("RecipeArchivedBy")
  recipeRevisions           RecipeRevision[]
  crateRegistrations        CrateRegistration[]
  crateLabelPrintJobs       CrateLabelPrintJob[]
  crateEvents               CrateEvent[]
  workstationsCreated       Workstation[]
  workstationEvents         WorkstationEvent[]
  workstationSessions       WorkstationSession[]      @relation("SessionUser")
  workstationSessionsClosed WorkstationSession[]      @relation("SessionClosedBy")
  workstationSessionEvents  WorkstationSessionEvent[]

  shipmentsCreated     Shipment[]               @relation("ShipmentCreatedBy")
  shipmentsCancelled   Shipment[]               @relation("ShipmentCancelledBy")
  shipmentsCancelAsked Shipment[]               @relation("ShipmentCancelRequestedBy")
  parcelWeighings      ShipmentParcelWeighing[] @relation("ParcelWeighedBy")
  carrierRequests      ShipmentCarrierRequest[] @relation("CarrierRequestBy")

  carrierSettingsVerified   SiteCarrierSetting[] @relation("CarrierSettingVerifiedBy")
  carrierSettingsUpdated    SiteCarrierSetting[] @relation("CarrierSettingUpdatedBy")
  carrierConnectionsUpdated CarrierConnection[]  @relation("CarrierConnectionUpdatedBy")
  printAgentsCreated        PrintAgent[]         @relation("PrintAgentCreatedBy")
  printAgentsRevoked        PrintAgent[]         @relation("PrintAgentRevokedBy")
  printersCreated           Printer[]            @relation("PrinterCreatedBy")
  printersUpdated           Printer[]            @relation("PrinterUpdatedBy")
  printRequests             PrintRequest[]       @relation("PrintRequestedBy")
  printJobEvents            PrintJobEvent[]      @relation("PrintJobEventBy")

  salesProspectsOwned    SalesProspect[] @relation("SalesProspectOwner")
  salesProspectsCreated  SalesProspect[] @relation("SalesProspectCreatedBy")
  salesProspectsUpdated  SalesProspect[] @relation("SalesProspectUpdatedBy")
  salesProspectsArchived SalesProspect[] @relation("SalesProspectArchivedBy")
  salesImportsOwned      SalesImport[]   @relation("SalesImportOwner")
  salesImportsCreated    SalesImport[]   @relation("SalesImportCreatedBy")
  salesContactsCreated   SalesContact[]  @relation("SalesContactCreatedBy")
  salesContactsUpdated   SalesContact[]  @relation("SalesContactUpdatedBy")
  salesContactsRetired   SalesContact[]  @relation("SalesContactRetiredBy")
  salesActivities        SalesActivity[] @relation("SalesActivityAuthor")
  salesTasksAssigned     SalesTask[]     @relation("SalesTaskAssignee")
  salesTasksCreated      SalesTask[]     @relation("SalesTaskCreatedBy")
  salesTasksUpdated      SalesTask[]     @relation("SalesTaskUpdatedBy")
  salesTasksClosed       SalesTask[]     @relation("SalesTaskClosedBy")
  salesEvents            SalesEvent[]    @relation("SalesEventActor")

  @@map("users")
}

/// Owner 2026-10-23: admin-managed public business card; draft and publication are separate.
model EmployeeCard {
  userId           String    @id @map("user_id") @db.Uuid
  slug             String    @unique
  version          Int       @default(1)
  draft            Json
  published        Json?
  publishedVersion Int?      @map("published_version")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("employee_cards")
}

/// Immutable, normalized PNG owned by one user. Original upload is never served or persisted.
model EmployeeCardPhoto {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  storageKey String   @unique @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("employee_card_photos")
}

/// Link of an external identity (provider + subject) to an AYVO user.
/// DB: one active link per (provider, subject) and per (user, provider) (partial unique);
/// provider/subject/user immutable; unlink closes once; DELETE rejected.
model UserIdentity {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// "WORKOS" (production/DEV) or "TEST" (APP_ENV=test only).
  provider    String
  subject     String
  emailAtLink String    @map("email_at_link")
  linkedAt    DateTime  @default(now()) @map("linked_at") @db.Timestamptz(3)
  unlinkedAt  DateTime? @map("unlinked_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions UserSession[]

  @@index([userId])
  @@map("user_identities")
}

/// Native password + TOTP. Only created after successful second-factor enrollment.
model NativeCredential {
  userId         String   @id @map("user_id") @db.Uuid
  passwordHash   String   @map("password_hash")
  totpCiphertext String   @map("totp_ciphertext")
  revision       Int      @default(1)
  mfaRevision    Int      @default(1) @map("mfa_revision")
  lastTotpStep   BigInt   @map("last_totp_step")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("native_credentials")
}

/// One-use enrollment/password-reset tokens. Raw delivery material is authenticated ciphertext.
model NativeAuthToken {
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String                @map("user_id") @db.Uuid
  purpose            String
  tokenSha256        String                @unique @map("token_sha256") @db.Char(64)
  deliveryCiphertext String?               @map("delivery_ciphertext")
  revision           Int                   @default(1)
  credentialRevision Int                   @map("credential_revision")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime              @map("expires_at") @db.Timestamptz(3)
  claimedAt          DateTime?             @map("claimed_at") @db.Timestamptz(3)
  usedAt             DateTime?             @map("used_at") @db.Timestamptz(3)
  revokedAt          DateTime?             @map("revoked_at") @db.Timestamptz(3)
  sentAt             DateTime?             @map("sent_at") @db.Timestamptz(3)
  deliveryAttempts   Int                   @default(0) @map("delivery_attempts")
  nextDeliveryAt     DateTime              @default(now()) @map("next_delivery_at") @db.Timestamptz(3)
  deliveryLeaseUntil DateTime?             @map("delivery_lease_until") @db.Timestamptz(3)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  challenges         NativeAuthChallenge[]

  @@index([userId, purpose])
  @@index([nextDeliveryAt])
  @@map("native_auth_tokens")
}

/// HttpOnly preauthentication cookie references this short-lived, one-use, limited challenge.
model NativeAuthChallenge {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  tokenSha256        String           @unique @map("token_sha256") @db.Char(64)
  kind               String
  credentialRevision Int              @map("credential_revision")
  actionId           String?          @map("action_id") @db.Uuid
  actionRevision     Int?             @map("action_revision")
  passwordHash       String?          @map("password_hash")
  totpCiphertext     String?          @map("totp_ciphertext")
  nextPath           String           @default("/") @map("next_path")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz(3)
  attempts           Int              @default(0)
  usedAt             DateTime?        @map("used_at") @db.Timestamptz(3)
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  action             NativeAuthToken? @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("native_auth_challenges")
}

/// High-entropy, user-bound recovery code hashes; consumption/retirement is retained.
model NativeRecoveryCode {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  codeSha256  String    @unique @map("code_sha256") @db.Char(64)
  mfaRevision Int       @map("mfa_revision")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, mfaRevision])
  @@map("native_recovery_codes")
}

/// Roles. System roles (is_system) are seeded and change only by migration; custom roles are
/// created by ADMIN (doc 021 §7a). DB: never deleted; code, id and is_system immutable; a role
/// with open grants cannot be deactivated; an inactive role cannot be granted.
model Role {
  code          String    @id
  /// Stable identifier (the code is the human-readable key).
  id            String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Czech display name.
  name          String
  description   String
  isSystem      Boolean   @default(false) @map("is_system")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  permissions   RolePermission[]
  grants        UserRole[]
  createdByUser User?            @relation("RoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?            @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("roles")
}

/// Permission catalogue. DB: seeded by migration; changes only by migration.
model Permission {
  code            String          @id
  description     String
  /// Also requires access to the active site and its warehouse (doc 022).
  warehouseScoped Boolean         @map("warehouse_scoped")
  /// Security administration: only the ADMIN system role may hold it (never a custom role).
  securityAdmin   Boolean         @default(false) @map("security_admin")
  /// Needs the active site (without a warehouse) and filters its data by that site (doc 022).
  siteScoped      Boolean         @default(false) @map("site_scoped")
  /// The site capability the active site must have for this permission.
  siteCapability  SiteCapability? @map("site_capability")

  roles RolePermission[]

  @@map("permissions")
}

/// Which permissions a role grants. DB: system roles change only by migration; custom roles by
/// ADMIN (audited); a custom role never holds a security-administration permission.
model RolePermission {
  roleCode       String @map("role_code")
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

/// A role granted to a user. Revocation closes the grant once; the grant row stays as history.
/// DB: at most one open grant per (user, role) (partial unique); DELETE rejected.
model UserRole {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleCode     String    @map("role_code")
  grantedAt    DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedBy    String?   @map("granted_by") @db.Uuid
  grantReason  String    @map("grant_reason")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user          User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role          Role  @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  grantedByUser User? @relation("RoleGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("RoleRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_roles")
}

enum ScopeType {
  WAREHOUSE
  SITE
  HOTEL_ORGANIZATION
  HOTEL_SITE
}

/// Data access scope of a user (doc 022). SITE references a site (facility); WAREHOUSE narrows a
/// site to listed warehouses and needs an open SITE scope of the warehouse's site; hotel scopes
/// reference hotel organizations/sites once those modules exist (no FK yet).
/// DB: SITE ⇔ site_id set; WAREHOUSE ⇔ location_id set; hotel scopes ⇔ scope_ref set; at most
/// one open scope per target (partial unique); revocation closes once; DELETE rejected.
model UserScope {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       ScopeType
  siteId     String?   @map("site_id") @db.Uuid
  locationId String?   @map("location_id") @db.Uuid
  scopeRef   String?   @map("scope_ref") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedBy  String?   @map("granted_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy  String?   @map("revoked_by") @db.Uuid

  user          User               @relation("UserScopes", fields: [userId], references: [id], onDelete: Restrict)
  site          Site?              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  location      InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  grantedByUser User?              @relation("ScopeGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  revokedByUser User?              @relation("ScopeRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_scopes")
}

/// An AYVO application session. Only the SHA-256 of the random cookie token is stored.
/// DB: token hash unique; revocation closes once.
model UserSession {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenSha256       String    @unique @map("token_sha256") @db.Char(64)
  userId            String    @map("user_id") @db.Uuid
  identityId        String    @map("identity_id") @db.Uuid
  /// The provider's session id (for provider logout); never a credential.
  providerSessionId String?   @map("provider_session_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason")
  /// The site the user works at in this session (validated against the scopes on every request).
  activeSiteId      String?   @map("active_site_id") @db.Uuid

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  identity   UserIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  activeSite Site?        @relation(fields: [activeSiteId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_sessions")
}

/// One-time OAuth state of a login attempt (CSRF protection of the callback, PKCE verifier).
/// DB: state hash unique; used once.
model AuthLoginState {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stateSha256   String    @unique @map("state_sha256") @db.Char(64)
  /// SHA-256 of the browser-binding cookie set when the attempt started.
  bindingSha256 String    @map("binding_sha256") @db.Char(64)
  codeVerifier  String    @map("code_verifier")
  nextPath      String    @map("next_path")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)

  @@map("auth_login_states")
}

/// The one-time bootstrap of the first administrator. DB: a single row ever (PK = true);
/// insert-only.
model IdentityBootstrap {
  singleton Boolean  @id @default(true)
  userId    String   @unique @map("user_id") @db.Uuid
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("identity_bootstrap")
}

/// Append-only security and administration audit (logins, role and scope changes, …).
/// DB: UPDATE/DELETE rejected.
model AuditEvent {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         String
  /// NULL for system actions (bootstrap) and anonymous login attempts.
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  reason       String?
  payload      Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// The site a site-specific event concerns (doc 022).
  siteId       String?  @map("site_id") @db.Uuid

  site Site? @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([targetUserId, occurredAt])
  @@index([siteId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

enum SiteCapability {
  WAREHOUSE
  PRODUCTION
  RETURNS
}

/// A physical AYVO facility — the top-level operational boundary (doc 022, ADR 0023). Not a
/// country and not a legal entity. DB: code unique and immutable; never deleted; a valid IANA
/// time zone; deactivation keeps history and blocks new operational changes.
model Site {
  hotels          Hotel[]
  orders          Order[]
  crateCycles     CrateCycle[]
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code            String           @unique
  name            String
  /// ISO 3166-1 alpha-2.
  countryCode     String           @map("country_code") @db.Char(2)
  addressLine1    String?          @map("address_line1")
  addressLine2    String?          @map("address_line2")
  postalCode      String?          @map("postal_code")
  city            String?
  /// IANA time zone used to present this site's timestamps (stored in UTC).
  timeZone        String           @map("time_zone")
  defaultLocale   String           @map("default_locale")
  /// ISO 4217.
  defaultCurrency String           @map("default_currency") @db.Char(3)
  capabilities    SiteCapability[]
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?          @map("created_by") @db.Uuid
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?          @map("updated_by") @db.Uuid
  deactivatedAt   DateTime?        @map("deactivated_at") @db.Timestamptz(3)

  locations           InventoryLocation[]
  goodsReceipts       GoodsReceipt[]
  bottleBatches       BottleCreationBatch[]
  bottles             Bottle[]
  printJobs           LabelPrintJob[]
  documents           SupplierDocument[]
  receiptCosts        GoodsReceiptLineCost[]
  userScopes          UserScope[]
  activeSessions      UserSession[]
  auditEvents         AuditEvent[]
  crateRegistrations  CrateRegistration[]
  crates              Crate[]
  crateLabelPrintJobs CrateLabelPrintJob[]
  crateEvents         CrateEvent[]
  workstations        Workstation[]
  workstationSessions WorkstationSession[]
  createdByUser       User?                  @relation("SiteCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser       User?                  @relation("SiteUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  shipments Shipment[]

  carrierSetting    SiteCarrierSetting?
  printAgents       PrintAgent[]
  printers          Printer[]
  printRequests     PrintRequest[]
  dispatchPrintJobs PrintJob[]

  supplyPlans SupplyPlan[]

  @@map("sites")
}

enum UserInvitationState {
  /// Recorded; the provider call is in progress (or was interrupted and is reconciled on retry).
  SENDING
  /// Sent by the provider; the person has not registered yet.
  PENDING
  /// The person registered through it and signed in: the identity is linked.
  ACCEPTED
  EXPIRED
  REVOKED
  /// The provider refused or failed; nothing was sent.
  FAILED
}

/// An invitation of a prepared AYVO user to register with the identity provider (doc 021 §7b).
/// The provider id is stored; invitation tokens and links are never stored or logged.
/// DB: one open (SENDING/PENDING) invitation per e-mail and per user (partial unique); e-mail =
/// the user's e-mail; only forward state transitions; identity columns immutable; never deleted.
model UserInvitation {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  email                String
  provider             String
  providerInvitationId String?             @unique @map("provider_invitation_id")
  state                UserInvitationState @default(SENDING)
  expiresAt            DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy            String?             @map("created_by") @db.Uuid
  sentAt               DateTime?           @map("sent_at") @db.Timestamptz(3)
  acceptedAt           DateTime?           @map("accepted_at") @db.Timestamptz(3)
  /// The provider user that accepted it (must equal the linked identity's subject).
  acceptedSubject      String?             @map("accepted_subject")
  revokedAt            DateTime?           @map("revoked_at") @db.Timestamptz(3)
  revokedBy            String?             @map("revoked_by") @db.Uuid
  failureCode          String?             @map("failure_code")
  requestId            String              @unique @map("request_id") @db.Uuid

  user          User                    @relation("UserInvitations", fields: [userId], references: [id], onDelete: Restrict)
  createdByUser User?                   @relation("InvitationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revokedByUser User?                   @relation("InvitationRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)
  requests      UserInvitationRequest[]

  @@index([userId, createdAt])
  @@map("user_invitations")
}

/// One administrative invitation action (send, resend, revoke) by its client request id: makes
/// every action idempotent and safe to retry. DB: STARTED → DONE once; never deleted.
model UserInvitationRequest {
  requestId    String    @id @map("request_id") @db.Uuid
  invitationId String    @map("invitation_id") @db.Uuid
  kind         String
  status       String    @default("STARTED")
  actorId      String?   @map("actor_id") @db.Uuid
  reason       String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  /// While set and in the future, one attempt is talking to the provider; others wait.
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz(3)
  /// The real result once DONE (SENT, RESENT, REVOKED, FAILED, SKIPPED_ACCEPTED, SKIPPED_CLOSED):
  /// a retry of the same request answers the same.
  outcome      String?

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([invitationId])
  @@map("user_invitation_requests")
}

// ---------------------------------------------------------------------------------------------
// catalog module — product categories, catalogue components, products and their versioned
// recipes (= product BOMs); crate types (crates module). Company-wide master data (doc 023): no
// stock quantity and no site — quantities stay in the ledger of each site's warehouses.
// ---------------------------------------------------------------------------------------------

/// Confirmed reference data (HAND_SOAP, SHOWER_GEL; doc 020), seeded by migration.
/// DB: code pattern; UPDATE/DELETE/TRUNCATE rejected.
model ProductCategory {
  code String @id
  name String

  components   CatalogComponent[]
  products     Product[]
  crateTypes   CrateTypeCategory[]
  workstations Workstation[]

  @@map("product_categories")
}

/// Catalogue profile of an inventory item used as a product component. The item itself (code,
/// kind, base unit, lot tracking) stays the inventory catalogue entry; quantities stay in the
/// ledger. DB: immutable; liquid and label items name a category; package capacity only for
/// packaging (NULL = not known yet).
model CatalogComponent {
  itemId             String   @id @map("item_id") @db.Uuid
  /// The product category the component is made for (NULL = usable for every category).
  categoryCode       String?  @map("category_code")
  /// Bottles per package (PACKAGING only); NULL = not known yet — never guessed.
  packageCapacity    Int?     @map("package_capacity")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String   @map("created_by") @db.Uuid
  operationRequestId String   @map("operation_request_id") @db.Uuid

  item      InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  category  ProductCategory? @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  creator   User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  operation OperationRequest @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)

  @@map("catalog_components")
}

/// A returnable production crate type (ADR 0021): capacity is data, never a constant.
/// DB: code pattern; capacity 1–1000; immutable; DELETE rejected.
model CrateType {
  tareWeights        CrateTypeTareWeight[]
  dimensions         CrateTypeDimension[]
  orderLines         OrderLine[]
  cycles             CrateCycle[]
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code               String                @unique
  name               String
  capacity           Int
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String                @map("created_by") @db.Uuid
  operationRequestId String                @map("operation_request_id") @db.Uuid

  categories    CrateTypeCategory[]
  registrations CrateRegistration[]
  crates        Crate[]
  creator       User                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  operation     OperationRequest    @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)

  @@map("crate_types")
}

/// The product categories a crate type carries. DB: insert-only.
model CrateTypeCategory {
  crateTypeId  String @map("crate_type_id") @db.Uuid
  categoryCode String @map("category_code")

  crateType CrateType        @relation(fields: [crateTypeId], references: [id], onDelete: Restrict)
  category  ProductCategory  @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  revisions RecipeRevision[]

  @@id([crateTypeId, categoryCode])
  @@map("crate_type_categories")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// A sellable product variant ("Tekuté mýdlo 330 ml"); not a label template (doc 020).
/// DB: code pattern; nominal quantity > 0 in its unit's scale; code, category, nominal quantity
/// and creation immutable; the name may be corrected while ACTIVE (audited); status forward-only;
/// DELETE rejected.
model Product {
  referenceWeights   ProductReferenceWeight[]
  orderLines         OrderLine[]
  labelApprovals     ProductLabelApproval[]
  cycles             CrateCycle[]
  bindings           BottleProductBinding[]
  sessions           WorkstationSession[]
  id                 String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code               String                   @unique
  name               String
  categoryCode       String                   @map("category_code")
  nominalQuantity    Decimal                  @map("nominal_quantity") @db.Decimal(19, 3)
  nominalUnitId      String                   @map("nominal_unit_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String                   @map("created_by") @db.Uuid
  operationRequestId String                   @map("operation_request_id") @db.Uuid
  /// ACTIVE → ARCHIVED (forward only). An archived product gets no new recipe work.
  status             ProductStatus            @default(ACTIVE)
  archivedAt         DateTime?                @map("archived_at") @db.Timestamptz(3)
  archivedBy         String?                  @map("archived_by") @db.Uuid

  category    ProductCategory  @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  nominalUnit InventoryUnit    @relation(fields: [nominalUnitId], references: [id], onDelete: Restrict)
  creator     User             @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  archiver    User?            @relation("ProductArchivedBy", fields: [archivedBy], references: [id], onDelete: Restrict)
  operation   OperationRequest @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  recipes     RecipeVersion[]

  supplyPlanRules SupplyPlanRule[]

  @@unique([id, categoryCode])
  @@map("products")
}

enum RecipeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// One version of a product's recipe (= its bill of materials per finished bottle).
/// DB: (product, version) unique; at most one ACTIVE per product (partial unique); forward-only
/// status DRAFT → ACTIVE → ARCHIVED (or DRAFT → ARCHIVED); activation only when complete;
/// identity columns immutable; DELETE rejected. Only a DRAFT gains revisions.
model RecipeVersion {
  referenceWeights   ProductReferenceWeight[]
  orderLines         OrderLine[]
  cycles             CrateCycle[]
  sessions           WorkstationSession[]
  id                 String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId          String                   @map("product_id") @db.Uuid
  /// Copy of the product's category (composite FK) so components and crates can be checked.
  categoryCode       String                   @map("category_code")
  version            Int
  status             RecipeStatus             @default(DRAFT)
  /// The version this one was copied from ("new version"), if any — same product.
  basedOnId          String?                  @map("based_on_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String                   @map("created_by") @db.Uuid
  operationRequestId String                   @map("operation_request_id") @db.Uuid
  activatedAt        DateTime?                @map("activated_at") @db.Timestamptz(3)
  activatedBy        String?                  @map("activated_by") @db.Uuid
  archivedAt         DateTime?                @map("archived_at") @db.Timestamptz(3)
  archivedBy         String?                  @map("archived_by") @db.Uuid

  product   Product          @relation(fields: [productId, categoryCode], references: [id, categoryCode], onDelete: Restrict)
  basedOn   RecipeVersion?   @relation("RecipeBasedOn", fields: [basedOnId, productId], references: [id, productId], onDelete: Restrict)
  copies    RecipeVersion[]  @relation("RecipeBasedOn")
  creator   User             @relation("RecipeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  activator User?            @relation("RecipeActivatedBy", fields: [activatedBy], references: [id], onDelete: Restrict)
  archiver  User?            @relation("RecipeArchivedBy", fields: [archivedBy], references: [id], onDelete: Restrict)
  operation OperationRequest @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  revisions RecipeRevision[]

  @@unique([productId, version])
  @@unique([id, productId])
  @@unique([id, categoryCode])
  @@map("recipe_versions")
}

/// The content of a recipe version at one revision: its crate type and, per stage, one
/// recipe-owned BOM version (immutable bom_versions/bom_lines). Editing a draft appends the next
/// revision; the highest revision is current and is frozen by activation. DB: insert-only;
/// revisions consecutive and only while DRAFT; crate type must carry the product's category.
model RecipeRevision {
  recipeVersionId    String   @map("recipe_version_id") @db.Uuid
  revision           Int
  categoryCode       String   @map("category_code")
  /// Returnable crate type the finished bottles go into (required for activation).
  crateTypeId        String?  @map("crate_type_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String   @map("created_by") @db.Uuid
  operationRequestId String   @map("operation_request_id") @db.Uuid

  recipeVersion RecipeVersion       @relation(fields: [recipeVersionId, categoryCode], references: [id, categoryCode], onDelete: Restrict)
  crateType     CrateTypeCategory?  @relation(fields: [crateTypeId, categoryCode], references: [crateTypeId, categoryCode], onDelete: Restrict)
  creator       User                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  operation     OperationRequest    @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  boms          RecipeRevisionBom[]

  @@id([recipeVersionId, revision])
  @@map("recipe_revisions")
}

/// One stage BOM of a recipe revision (doc 020 §3.3: RecipeComponent = bom_lines). A BOM version
/// belongs to at most one recipe revision, ever. DB: insert-only; the BOM's stage equals `stage`;
/// its lines are checked against the stage, the unit dimension and the product category, and no
/// item or component kind repeats within the revision; no line can be added afterwards.
model RecipeRevisionBom {
  recipeVersionId String           @map("recipe_version_id") @db.Uuid
  revision        Int
  stage           ConsumptionStage
  bomVersionId    String           @unique @map("bom_version_id") @db.Uuid

  recipeRevision RecipeRevision @relation(fields: [recipeVersionId, revision], references: [recipeVersionId, revision], onDelete: Restrict)
  bomVersion     BomVersion     @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)

  @@id([recipeVersionId, revision, stage])
  @@map("recipe_revision_boms")
}

// ---------------------------------------------------------------------------------------------
// crates module — physical returnable crates and their QR labels (doc 020 §3.4, ADR 0021 §6,
// doc 025 PR A1). Crate cycles, assignments and filling are later PRs (doc 025 §9).
// ---------------------------------------------------------------------------------------------

enum QrIdentityKind {
  BOTTLE
  CRATE
  WORKSTATION
}

/// One registry of every public QR token, so a token is unique across bottles and crates
/// (doc 020 §3.4). Rows are written only by the database (insert triggers on bottles and
/// crates; existing bottle tokens copied by the migration). DB: immutable.
model QrIdentity {
  token     String         @id
  kind      QrIdentityKind
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  crates       Crate[]
  workstations Workstation[]

  @@unique([token, kind])
  @@map("qr_identities")
}

enum CrateStatus {
  ACTIVE
  /// Reserved: crate retirement is a later, approved workflow (doc 005); never set in A1.
  RETIRED
}

/// One registration of 1–1000 physical crates of one type at one site ("CR-000001").
/// DB: immutable; code derived from serial; last − first + 1 = quantity.
model CrateRegistration {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial             BigInt   @unique
  code               String   @unique
  crateTypeId        String   @map("crate_type_id") @db.Uuid
  quantity           Int
  firstCrateSerial   BigInt   @map("first_crate_serial")
  lastCrateSerial    BigInt   @map("last_crate_serial")
  siteId             String   @map("site_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String   @map("created_by") @db.Uuid
  operationRequestId String   @unique @map("operation_request_id") @db.Uuid

  crateType CrateType        @relation(fields: [crateTypeId], references: [id], onDelete: Restrict)
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  creator   User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  operation OperationRequest @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  crates    Crate[]
  events    CrateEvent[]

  @@unique([id, siteId])
  @@map("crate_registrations")
}

/// A physical returnable crate: permanent internal id, human code "AYV-C-000001" and an opaque
/// QR token (scan identity; never the code or the id). The crate lives for years; its
/// circulations are crate cycles (later PR). site_id = the site it belongs to (doc 022).
/// DB: identity columns immutable; DELETE rejected; token registered as kind CRATE.
model Crate {
  orderAllocations OrderCrateAllocation[]
  cycles           CrateCycle[]
  sessions         WorkstationSession[]
  id               String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial           BigInt                 @unique
  code             String                 @unique
  qrToken          String                 @unique @map("qr_token")
  /// Always CRATE: composite FK to the registry row of this token.
  qrKind           QrIdentityKind         @default(CRATE) @map("qr_kind")
  crateTypeId      String                 @map("crate_type_id") @db.Uuid
  registrationId   String                 @map("registration_id") @db.Uuid
  siteId           String                 @map("site_id") @db.Uuid
  status           CrateStatus            @default(ACTIVE)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  qrIdentity    QrIdentity               @relation(fields: [qrToken, qrKind], references: [token, kind], onDelete: Restrict)
  crateType     CrateType                @relation(fields: [crateTypeId], references: [id], onDelete: Restrict)
  registration  CrateRegistration        @relation(fields: [registrationId, siteId], references: [id, siteId], onDelete: Restrict)
  site          Site                     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  printJobItems CrateLabelPrintJobItem[]
  events        CrateEvent[]

  shipmentParcels ShipmentParcel[]

  @@index([siteId, serial])
  @@index([crateTypeId])
  @@map("crates")
}

/// One rendering of crate QR labels for a fixed set of crates of one site, at a chosen physical
/// size (not yet physically approved, doc 025 Q7). A reprint is a new job with the same tokens,
/// hence the same URLs. Code shares the "PJ-" counter with bottle print jobs.
/// DB: identity columns immutable; DELETE rejected; QR environment CHECK (ADR 0014).
model CrateLabelPrintJob {
  id                 String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial             BigInt                 @unique
  code               String                 @unique
  siteId             String                 @map("site_id") @db.Uuid
  labelCount         Int                    @map("label_count")
  widthMm            Int                    @map("width_mm")
  heightMm           Int                    @map("height_mm")
  publicBaseUrl      String                 @map("public_base_url")
  appEnvironment     AppEnvironment         @map("app_environment")
  qrErrorCorrection  QrErrorCorrectionLevel @map("qr_error_correction")
  status             LabelPrintJobStatus    @default(PENDING)
  attempts           Int                    @default(0)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String                 @map("created_by") @db.Uuid
  operationRequestId String                 @unique @map("operation_request_id") @db.Uuid
  startedAt          DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?              @map("completed_at") @db.Timestamptz(3)
  failedAt           DateTime?              @map("failed_at") @db.Timestamptz(3)
  failureReason      String?                @map("failure_reason")
  fileStorageKey     String?                @map("file_storage_key")
  fileByteSize       Int?                   @map("file_byte_size")
  fileSha256         String?                @map("file_sha256") @db.Char(64)

  site      Site                     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  creator   User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  operation OperationRequest         @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  items     CrateLabelPrintJobItem[]
  events    CrateEvent[]

  @@index([siteId, serial])
  @@map("crate_label_print_jobs")
}

/// The exact crates of a crate print job, in page order. DB: immutable; the QR URL is exactly the
/// job's base URL + "/" + the crate's token; the crate belongs to the job's site.
model CrateLabelPrintJobItem {
  printJobId String @map("print_job_id") @db.Uuid
  position   Int
  crateId    String @map("crate_id") @db.Uuid
  qrUrl      String @map("qr_url")

  printJob CrateLabelPrintJob @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  crate    Crate              @relation(fields: [crateId], references: [id], onDelete: Restrict)

  @@id([printJobId, position])
  @@unique([printJobId, crateId])
  @@index([crateId])
  @@map("crate_label_print_job_items")
}

enum CrateEventType {
  REGISTERED
  /// A crate label print job including this crate was created. Printing itself is not provable.
  LABEL_PRINT_JOB_CREATED
  CYCLE_OPENED
  READY_TO_FILL
  FILLING_STARTED
  CRATE_FILLED
  RETURNED_TO_FILLING
  CYCLE_ABORTED
  MEMBER_REMOVED
  MEMBER_ADDED
  ALLOCATED_TO_ORDER
  RELEASED_FROM_ORDER
  /// Its parcel is with the carrier (doc 029, doc 031) — not delivered, not at the hotel.
  DISPATCHED
  /// Its parcel was delivered, per the carrier (doc 031).
  DELIVERED
}

/// Append-only crate history (ADR 0006). location_id = last recorded physical location, NULL when
/// the operation does not record one (registration records only the site). DB: immutable.
model CrateEvent {
  weightSnapshot     CrateCycleWeightSnapshot?
  cycleId            String?                   @map("cycle_id") @db.Uuid
  cycle              CrateCycle?               @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  id                 String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  crateId            String                    @map("crate_id") @db.Uuid
  type               CrateEventType
  occurredAt         DateTime                  @map("occurred_at") @db.Timestamptz(3)
  recordedAt         DateTime                  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// NULL exactly for events recorded from the carrier (source CARRIER, ADR 0029).
  actorId            String?                   @map("actor_id") @db.Uuid
  source             String                    @default("USER")
  siteId             String                    @map("site_id") @db.Uuid
  locationId         String?                   @map("location_id") @db.Uuid
  operationRequestId String                    @map("operation_request_id") @db.Uuid
  registrationId     String?                   @map("registration_id") @db.Uuid
  printJobId         String?                   @map("print_job_id") @db.Uuid
  payload            Json                      @default("{}")

  crate        Crate               @relation(fields: [crateId], references: [id], onDelete: Restrict)
  actor        User?               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  site         Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  location     InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  operation    OperationRequest    @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  registration CrateRegistration?  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  printJob     CrateLabelPrintJob? @relation(fields: [printJobId], references: [id], onDelete: Restrict)

  @@index([crateId, occurredAt])
  @@map("crate_events")
}

// ---------------------------------------------------------------------------------------------
// workstations module — stations as work modes at a site and their work sessions (doc 026, A2).
// A station QR identifies the station only: never a login, permission or secret.
// ---------------------------------------------------------------------------------------------

enum WorkstationMode {
  LABELING
  FILLING
}

enum WorkstationStatus {
  ACTIVE
  INACTIVE
}

/// A work mode at one site, e.g. "Plnicí linka gel 1". Never a site or warehouse.
/// DB: identity columns immutable; the warehouse belongs to the site; FILLING ⇔ category; a
/// status change needs its event in the same transaction; DELETE rejected.
model Workstation {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code               String            @unique
  name               String
  siteId             String            @map("site_id") @db.Uuid
  locationId         String            @map("location_id") @db.Uuid
  mode               WorkstationMode
  categoryCode       String?           @map("category_code")
  status             WorkstationStatus @default(ACTIVE)
  qrToken            String            @unique @map("qr_token")
  /// Always WORKSTATION: composite FK to the registry row of this token.
  qrKind             QrIdentityKind    @default(WORKSTATION) @map("qr_kind")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String            @map("created_by") @db.Uuid
  operationRequestId String            @unique @map("operation_request_id") @db.Uuid

  site       Site                 @relation(fields: [siteId], references: [id], onDelete: Restrict)
  location   InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category   ProductCategory?     @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  qrIdentity QrIdentity           @relation(fields: [qrToken, qrKind], references: [token, kind], onDelete: Restrict)
  creator    User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  operation  OperationRequest     @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  events     WorkstationEvent[]
  sessions   WorkstationSession[]

  @@index([siteId, code])
  @@map("workstations")
}

enum WorkstationEventType {
  CREATED
  DEACTIVATED
  REACTIVATED
}

/// Append-only station history. DB: immutable; (de)activation needs a reason.
model WorkstationEvent {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workstationId      String               @map("workstation_id") @db.Uuid
  type               WorkstationEventType
  occurredAt         DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId            String               @map("actor_id") @db.Uuid
  operationRequestId String               @map("operation_request_id") @db.Uuid
  reason             String?

  workstation Workstation      @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  actor       User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  operation   OperationRequest @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)

  @@index([workstationId, occurredAt])
  @@map("workstation_events")
}

enum WorkstationSessionStatus {
  ACTIVE
  RELEASED
  TAKEN_OVER
  CLOSED
}

/// One user working at one station. DB: at most one ACTIVE session per station and per user
/// (partial unique); the site is the station's; only ACTIVE → RELEASED/TAKEN_OVER/CLOSED, once,
/// with its event; identity columns immutable; DELETE rejected. Lease expiry is not a status.
model WorkstationSession {
  /// Labelling context (doc 025, A3): chosen once, re-validated on every scan.
  productId               String?                  @map("product_id") @db.Uuid
  recipeVersionId         String?                  @map("recipe_version_id") @db.Uuid
  labelTemplateVersionId  String?                  @map("label_template_version_id") @db.Uuid
  sourceLotId             String?                  @map("source_lot_id") @db.Uuid
  /// Filling station: the explicitly chosen liquid lot, applies to the following bottles (B5).
  liquidLotId             String?                  @map("liquid_lot_id") @db.Uuid
  liquidLot               InventoryLot?            @relation("SessionLiquidLot", fields: [liquidLotId], references: [id], onDelete: Restrict)
  /// Bumped by every context change or crate load: a labelling scan names the revision it was
  /// made in, so a retry from an older context is refused (PR #23 review).
  labelingContextRevision Int                      @default(0) @map("labeling_context_revision")
  /// The crate loaded at the station (at most one active session per crate).
  crateId                 String?                  @map("crate_id") @db.Uuid
  product                 Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipeVersion           RecipeVersion?           @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  labelTemplateVersion    LabelTemplateVersion?    @relation(fields: [labelTemplateVersionId], references: [id], onDelete: Restrict)
  sourceLot               InventoryLot?            @relation("SessionSourceLot", fields: [sourceLotId], references: [id], onDelete: Restrict)
  crate                   Crate?                   @relation(fields: [crateId], references: [id], onDelete: Restrict)
  bottleEvents            BottleEvent[]
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workstationId           String                   @map("workstation_id") @db.Uuid
  userId                  String                   @map("user_id") @db.Uuid
  siteId                  String                   @map("site_id") @db.Uuid
  status                  WorkstationSessionStatus @default(ACTIVE)
  openedAt                DateTime                 @default(now()) @map("opened_at") @db.Timestamptz(3)
  leaseExpiresAt          DateTime                 @map("lease_expires_at") @db.Timestamptz(3)
  lastActivityAt          DateTime                 @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  closedAt                DateTime?                @map("closed_at") @db.Timestamptz(3)
  closedBy                String?                  @map("closed_by") @db.Uuid
  closeReason             String?                  @map("close_reason")

  workstation Workstation               @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  user        User                      @relation("SessionUser", fields: [userId], references: [id], onDelete: Restrict)
  closer      User?                     @relation("SessionClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  site        Site                      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  events      WorkstationSessionEvent[]

  @@index([userId, openedAt])
  @@map("workstation_sessions")
}

enum WorkstationSessionEventType {
  OPENED
  RESUMED
  RELEASED
  TAKEN_OVER
  CLOSED
  CONTEXT_CHANGED
  CRATE_LOADED
  LIQUID_LOT_CHANGED
}

/// Append-only session history. DB: immutable; a takeover or close needs a reason.
model WorkstationSessionEvent {
  id                 String                      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId          String                      @map("session_id") @db.Uuid
  type               WorkstationSessionEventType
  occurredAt         DateTime                    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId            String                      @map("actor_id") @db.Uuid
  operationRequestId String                      @map("operation_request_id") @db.Uuid
  reason             String?

  session   WorkstationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  actor     User               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  operation OperationRequest   @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)

  @@index([sessionId, occurredAt])
  @@map("workstation_session_events")
}

// ---------------------------------------------------------------------------------------------
// Labelling into crates (doc 025 A3, docs 020 §3.3–§3.5, owner decisions B1–B4 2026-10-14).
// ---------------------------------------------------------------------------------------------

/// A label design (exact label template version) approved for exactly one product (owner B1).
/// DB: at most one open approval per design (partial unique); revoke once, with a reason;
/// identity immutable; DELETE rejected. Revoking blocks new labelling only.
model ProductLabelApproval {
  id                     String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId              String    @map("product_id") @db.Uuid
  labelTemplateVersionId String    @map("label_template_version_id") @db.Uuid
  reason                 String
  approvedAt             DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  approvedBy             String    @map("approved_by") @db.Uuid
  approveOperationId     String    @unique @map("approve_operation_id") @db.Uuid
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy              String?   @map("revoked_by") @db.Uuid
  revokeReason           String?   @map("revoke_reason")
  revokeOperationId      String?   @unique @map("revoke_operation_id") @db.Uuid

  product              Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  labelTemplateVersion LabelTemplateVersion @relation(fields: [labelTemplateVersionId], references: [id], onDelete: Restrict)
  approver             User                 @relation("ApprovalBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  revoker              User?                @relation("ApprovalRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)
  approveOperation     OperationRequest     @relation("ApproveOperation", fields: [approveOperationId], references: [requestId], onDelete: Restrict)
  revokeOperation      OperationRequest?    @relation("RevokeOperation", fields: [revokeOperationId], references: [requestId], onDelete: Restrict)

  @@index([productId])
  @@map("product_label_approvals")
}

enum CrateCycleStatus {
  OPEN_ASSEMBLY
  READY_TO_FILL
  FILLING
  FILLED
  ABORTED
  /// Scanned into an order (doc 028); back to FILLED when removed or the order is cancelled.
  ALLOCATED
  /// Its parcel is with the carrier (doc 029, doc 031). Not at the hotel.
  DISPATCHED
  /// Its parcel was delivered, per the carrier (doc 031). Terminal until returns exist; the
  /// bottles' reuse cycle is not completed by it (ADR 0011).
  DELIVERED
}

/// One circulation of one crate (ADR 0021, ADR 0025): an immutable snapshot (crate type,
/// capacity, product, category, recipe version, label design) and the current member count.
/// DB: one open cycle per crate; snapshot immutable; status only along the approved transitions
/// (A3 uses OPEN_ASSEMBLY → READY_TO_FILL); member_count = active assignments; OPEN_ASSEMBLY ⇒
/// fewer than capacity, READY_TO_FILL ⇒ exactly capacity (commit-time).
model CrateCycle {
  weightSnapshots        CrateCycleWeightSnapshot[]
  orderAllocations       OrderCrateAllocation[]
  id                     String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  crateId                String                     @map("crate_id") @db.Uuid
  siteId                 String                     @map("site_id") @db.Uuid
  status                 CrateCycleStatus           @default(OPEN_ASSEMBLY)
  crateTypeId            String                     @map("crate_type_id") @db.Uuid
  capacity               Int
  productId              String                     @map("product_id") @db.Uuid
  categoryCode           String                     @map("category_code")
  recipeVersionId        String                     @map("recipe_version_id") @db.Uuid
  labelTemplateVersionId String                     @map("label_template_version_id") @db.Uuid
  memberCount            Int                        @default(0) @map("member_count")
  /// Active members that are FILLED (doc 025 §3.2 "Naplněno"); changed only with their events.
  filledCount            Int                        @default(0) @map("filled_count")
  /// Set by Hotovo (FILLED); cleared again by "Vrátit do rozpracování".
  filledAt               DateTime?                  @map("filled_at") @db.Timestamptz(3)
  openedAt               DateTime                   @default(now()) @map("opened_at") @db.Timestamptz(3)
  openedBy               String                     @map("opened_by") @db.Uuid
  openOperationId        String                     @map("open_operation_id") @db.Uuid
  readyToFillAt          DateTime?                  @map("ready_to_fill_at") @db.Timestamptz(3)
  abortedAt              DateTime?                  @map("aborted_at") @db.Timestamptz(3)
  abortedBy              String?                    @map("aborted_by") @db.Uuid
  abortReason            String?                    @map("abort_reason")

  crate                Crate                  @relation(fields: [crateId], references: [id], onDelete: Restrict)
  site                 Site                   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  crateType            CrateType              @relation(fields: [crateTypeId], references: [id], onDelete: Restrict)
  product              Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipeVersion        RecipeVersion          @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  labelTemplateVersion LabelTemplateVersion   @relation(fields: [labelTemplateVersionId], references: [id], onDelete: Restrict)
  opener               User                   @relation("CycleOpenedBy", fields: [openedBy], references: [id], onDelete: Restrict)
  aborter              User?                  @relation("CycleAbortedBy", fields: [abortedBy], references: [id], onDelete: Restrict)
  openOperation        OperationRequest       @relation("CycleOpenOperation", fields: [openOperationId], references: [requestId], onDelete: Restrict)
  assignments          CrateAssignment[]
  events               CrateEvent[]
  bottleEvents         BottleEvent[]
  bindings             BottleProductBinding[]

  shipmentParcels ShipmentParcel[]

  @@unique([id, capacity])
  @@index([crateId, openedAt])
  @@map("crate_cycles")
}

enum CrateAssignmentSource {
  LABELING
  REPACKED
  REPLACEMENT
}

/// A bottle's membership in a crate cycle, with an ordinal (1…capacity; not a physical slot).
/// Released, never deleted. DB: one active assignment per bottle and per (cycle, ordinal);
/// ordinal ≤ the cycle's capacity (composite FK); inserted only into OPEN_ASSEMBLY; the bottle's
/// product binding matches the cycle snapshot; release fields set once.
model CrateAssignment {
  orderBottles       OrderAllocationBottle[]
  id                 String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cycleId            String                  @map("cycle_id") @db.Uuid
  cycleCapacity      Int                     @map("cycle_capacity")
  bottleId           String                  @map("bottle_id") @db.Uuid
  ordinal            Int
  source             CrateAssignmentSource
  assignedAt         DateTime                @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy         String                  @map("assigned_by") @db.Uuid
  operationRequestId String                  @map("operation_request_id") @db.Uuid
  assignedEventId    String                  @unique @map("assigned_event_id") @db.Uuid
  releasedAt         DateTime?               @map("released_at") @db.Timestamptz(3)
  releasedBy         String?                 @map("released_by") @db.Uuid
  releaseReason      String?                 @map("release_reason")
  releaseOperationId String?                 @map("release_operation_id") @db.Uuid

  cycle            CrateCycle        @relation(fields: [cycleId, cycleCapacity], references: [id, capacity], onDelete: Restrict)
  bottle           Bottle            @relation(fields: [bottleId], references: [id], onDelete: Restrict)
  assigner         User              @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  releaser         User?             @relation("ReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)
  operation        OperationRequest  @relation("AssignOperation", fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  releaseOperation OperationRequest? @relation("ReleaseOperation", fields: [releaseOperationId], references: [requestId], onDelete: Restrict)
  assignedEvent    BottleEvent       @relation("AssignmentEvent", fields: [assignedEventId], references: [id], onDelete: Restrict)

  @@index([cycleId])
  @@index([bottleId])
  @@map("crate_assignments")
}

/// The permanent product binding of a labelled bottle (owner B1): bound once at its labelling
/// scan, never changed by a scan (a future relabelling is a separate controlled procedure).
/// DB: insert-only; the event is that bottle's LABEL_APPLIED; product category = category.
model BottleProductBinding {
  bottleId               String   @id @map("bottle_id") @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  categoryCode           String   @map("category_code")
  labelTemplateVersionId String   @map("label_template_version_id") @db.Uuid
  labelAppliedEventId    String   @unique @map("label_applied_event_id") @db.Uuid
  crateCycleId           String   @map("crate_cycle_id") @db.Uuid
  boundAt                DateTime @default(now()) @map("bound_at") @db.Timestamptz(3)
  operationRequestId     String   @map("operation_request_id") @db.Uuid

  bottle               Bottle               @relation(fields: [bottleId], references: [id], onDelete: Restrict)
  product              Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  labelTemplateVersion LabelTemplateVersion @relation(fields: [labelTemplateVersionId], references: [id], onDelete: Restrict)
  labelAppliedEvent    BottleEvent          @relation(fields: [labelAppliedEventId], references: [id], onDelete: Restrict)
  crateCycle           CrateCycle           @relation(fields: [crateCycleId], references: [id], onDelete: Restrict)
  operation            OperationRequest     @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)

  @@map("bottle_product_bindings")
}

// ---------------------------------------------------------------------------------------------
// customers + orders modules — hotels, manual orders and picking of finished crates (doc 028).
// No contracts, billing, carriers or deliveries yet.
// ---------------------------------------------------------------------------------------------

/// A hotel with one delivery address and contact (doc 028 §1). The fulfilment site is chosen
/// explicitly, never derived from the country (doc 022 §7). DB: code and site immutable; never
/// deleted.
model Hotel {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial                BigInt   @unique
  code                  String   @unique
  name                  String
  addressLine1          String   @map("address_line1")
  addressLine2          String?  @map("address_line2")
  postalCode            String   @map("postal_code")
  city                  String
  countryCode           String   @map("country_code") @db.Char(2)
  contactName           String   @map("contact_name")
  contactPhone          String   @map("contact_phone")
  contactEmail          String   @map("contact_email")
  fulfillmentSiteId     String   @map("fulfillment_site_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy             String   @map("created_by") @db.Uuid
  operationRequestId    String   @unique @map("operation_request_id") @db.Uuid
  /// Optional practical details (doc 032): goods receipt hours, entrance, …; a receiving contact.
  deliveryNote          String?  @map("delivery_note")
  receivingContactName  String?  @map("receiving_contact_name")
  receivingContactPhone String?  @map("receiving_contact_phone")
  receivingContactEmail String?  @map("receiving_contact_email")

  fulfillmentSite Site             @relation(fields: [fulfillmentSiteId], references: [id], onDelete: Restrict)
  creator         User             @relation("HotelCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  operation       OperationRequest @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  orders          Order[]
  supplyPlan      SupplyPlan?

  @@index([fulfillmentSiteId])
  @@map("hotels")
}

enum OrderStatus {
  OPEN
  /// Kompletace dokončena (doc 028); the shipment and its parcels exist (doc 029).
  READY_TO_DISPATCH
  CANCELLED
  /// "Připraveno k vyzvednutí": labels created by the carrier and confirmed as applied (doc 029).
  READY_FOR_PICKUP
  /// "Převzatá dopravcem": every parcel with the carrier — proven by its tracking or an earlier
  /// manual hand-over (doc 029, doc 031). Never "delivered".
  HANDED_TO_CARRIER
  /// "Doručená": the carrier confirmed the delivery of every parcel (doc 031). Not a completed
  /// reuse cycle (ADR 0011).
  DELIVERED
}

/// A manual order of one hotel for one delivery address (doc 028). site_id = the hotel's
/// fulfilment site at creation; hotel name, address and contact are a historical snapshot.
/// DB: snapshot immutable; status OPEN → READY_TO_DISPATCH / CANCELLED, READY_TO_DISPATCH →
/// CANCELLED / READY_FOR_PICKUP, READY_FOR_PICKUP → READY_TO_DISPATCH / HANDED_TO_CARRIER
/// (doc 029); from READY_TO_DISPATCH on every line complete and exactly one shipment.
model Order {
  id                 String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial             BigInt      @unique
  code               String      @unique
  hotelId            String      @map("hotel_id") @db.Uuid
  siteId             String      @map("site_id") @db.Uuid
  status             OrderStatus @default(OPEN)
  requestedShipDate  DateTime    @map("requested_ship_date") @db.Date
  hotelName          String      @map("hotel_name")
  addressLine1       String      @map("address_line1")
  addressLine2       String?     @map("address_line2")
  postalCode         String      @map("postal_code")
  city               String
  countryCode        String      @map("country_code") @db.Char(2)
  contactName        String      @map("contact_name")
  contactPhone       String      @map("contact_phone")
  contactEmail       String      @map("contact_email")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String      @map("created_by") @db.Uuid
  operationRequestId String      @unique @map("operation_request_id") @db.Uuid
  completedAt        DateTime?   @map("completed_at") @db.Timestamptz(3)
  completedBy        String?     @map("completed_by") @db.Uuid
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy        String?     @map("cancelled_by") @db.Uuid
  cancelReason       String?     @map("cancel_reason")
  /// MANUAL or SUPPLY_PLAN (doc 032); a plan's order points to its occurrence.
  origin             String      @default("MANUAL")
  supplyOccurrenceId String?     @unique @map("supply_occurrence_id") @db.Uuid

  hotel            Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  supplyOccurrence SupplyPlanOccurrence?  @relation("OrderOfOccurrence", fields: [supplyOccurrenceId], references: [id], onDelete: Restrict)
  occurrenceOf     SupplyPlanOccurrence?  @relation("OccurrenceOrder")
  site             Site                   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  creator          User                   @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  completer        User?                  @relation("OrderCompletedBy", fields: [completedBy], references: [id], onDelete: Restrict)
  canceller        User?                  @relation("OrderCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  operation        OperationRequest       @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  lines            OrderLine[]
  allocations      OrderCrateAllocation[]
  events           OrderEvent[]
  shipments        Shipment[]
  printRequests    PrintRequest[]
  printJobs        PrintJob[]

  @@index([siteId, requestedShipDate])
  @@index([hotelId])
  @@map("orders")
}

/// One product of an order in whole crates; crate type and capacity are a snapshot of the
/// product's active recipe at order time; bottles = crates × capacity. DB: immutable except
/// allocated_crates (0…crates, equal to the active allocations at commit).
model OrderLine {
  id                     String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId                String  @map("order_id") @db.Uuid
  lineNo                 Int     @map("line_no")
  productId              String  @map("product_id") @db.Uuid
  crateTypeId            String  @map("crate_type_id") @db.Uuid
  capacity               Int
  crates                 Int
  bottles                Int
  allocatedCrates        Int     @default(0) @map("allocated_crates")
  /// Pinned by the first loaded crate, cleared when the line is empty again (no mixing).
  recipeVersionId        String? @map("recipe_version_id") @db.Uuid
  labelTemplateVersionId String? @map("label_template_version_id") @db.Uuid

  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recipeVersion        RecipeVersion?         @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  labelTemplateVersion LabelTemplateVersion?  @relation(fields: [labelTemplateVersionId], references: [id], onDelete: Restrict)
  product              Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  crateType            CrateType              @relation(fields: [crateTypeId], references: [id], onDelete: Restrict)
  allocations          OrderCrateAllocation[]

  @@unique([orderId, lineNo])
  @@unique([orderId, productId])
  @@map("order_lines")
}

/// A finished crate cycle loaded into an order line (picking). Released, never deleted.
/// DB: one active allocation per cycle; cycle ALLOCATED ⇔ active allocation; same site, product,
/// crate type and capacity as the line; release fields set once.
model OrderCrateAllocation {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  lineId             String    @map("line_id") @db.Uuid
  cycleId            String    @map("cycle_id") @db.Uuid
  crateId            String    @map("crate_id") @db.Uuid
  allocatedAt        DateTime  @map("allocated_at") @db.Timestamptz(3)
  allocatedBy        String    @map("allocated_by") @db.Uuid
  operationRequestId String    @map("operation_request_id") @db.Uuid
  releasedAt         DateTime? @map("released_at") @db.Timestamptz(3)
  releasedBy         String?   @map("released_by") @db.Uuid
  releaseReason      String?   @map("release_reason")
  releaseOperationId String?   @map("release_operation_id") @db.Uuid

  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  line             OrderLine               @relation(fields: [lineId], references: [id], onDelete: Restrict)
  cycle            CrateCycle              @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  crate            Crate                   @relation(fields: [crateId], references: [id], onDelete: Restrict)
  allocator        User                    @relation("AllocatedBy", fields: [allocatedBy], references: [id], onDelete: Restrict)
  releaser         User?                   @relation("AllocationReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)
  operation        OperationRequest        @relation("AllocateOperation", fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  releaseOperation OperationRequest?       @relation("AllocationReleaseOperation", fields: [releaseOperationId], references: [requestId], onDelete: Restrict)
  bottles          OrderAllocationBottle[]
  parcels          ShipmentParcel[]

  @@index([orderId])
  @@index([cycleId])
  @@index([crateId])
  @@map("order_crate_allocations")
}

/// The crate's bottle memberships at allocation time (the per-bottle trace). DB: insert-only;
/// the assignment is an active member of the allocation's cycle.
model OrderAllocationBottle {
  allocationId String @map("allocation_id") @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  bottleId     String @map("bottle_id") @db.Uuid

  allocation OrderCrateAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  assignment CrateAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  bottle     Bottle               @relation(fields: [bottleId], references: [id], onDelete: Restrict)

  @@id([allocationId, assignmentId])
  @@index([bottleId])
  @@map("order_allocation_bottles")
}

enum OrderEventType {
  CREATED
  CRATE_ADDED
  CRATE_REMOVED
  COMPLETED
  CANCELLED
  /// doc 029: the shipment and its parcels derived from the completed picking.
  SHIPMENT_CREATED
  LABELS_REQUESTED
  LABELS_CREATED
  LABELS_REJECTED
  /// The carrier's answer is unknown (timeout, lost response): never re-sent blindly.
  LABELS_UNCERTAIN
  /// The carrier confirmed that nothing was created for an uncertain request.
  LABELS_NOT_CREATED
  PARCEL_WEIGHED
  READY_FOR_PICKUP
  HANDED_TO_CARRIER
  SHIPMENT_CANCELLED
  SHIPMENT_CANCEL_REQUESTED
  SHIPMENT_CANCEL_REFUSED
  CARRIER_LATE_ANSWER
  /// doc 030: a further format of the stored labels (ZPL for printing) was stored / not obtained.
  LABEL_VARIANT_STORED
  LABEL_VARIANT_FAILED
  PRINT_REQUESTED
  REPRINT_REQUESTED
  PRINT_JOBS_CANCELLED
  /// doc 031: the carrier proved a parcel picked up / delivered; the whole order delivered.
  PARCEL_PICKED_UP
  PARCEL_DELIVERED
  DELIVERED
  /// doc 032: the planned ship day changed explicitly (reason in the payload).
  RESCHEDULED
}

/// Append-only order history (ADR 0006). DB: immutable.
model OrderEvent {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId            String         @map("order_id") @db.Uuid
  type               OrderEventType
  occurredAt         DateTime       @map("occurred_at") @db.Timestamptz(3)
  /// The user who did it; NULL exactly for events recorded from the carrier (source CARRIER,
  /// ADR 0029).
  actorId            String?        @map("actor_id") @db.Uuid
  /// USER or CARRIER (doc 031): who is the source of this fact.
  source             String         @default("USER")
  operationRequestId String         @map("operation_request_id") @db.Uuid
  payload            Json           @default("{}")

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  operation OperationRequest @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@map("order_events")
}

// ---------------------------------------------------------------------------------------------
// Weights and dimensions (doc 025 §10, PR W1, owner 2026-10-17): measured reference values for
// future dispatch. Append-only; a correction is a new row pointing to the corrected one. Unknown
// = no row, never 0. Recording never touches stock, units, consumption or production states.
// ---------------------------------------------------------------------------------------------

/// A measured reference weight of a component (inventory item): grams per one base unit (a
/// counted item: bottle body, pump, label), or for a volume item (a liquid) the weighed mass of
/// a stated sample volume in the item's base unit — never a density guess. DB: immutable.
model ItemReferenceWeight {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  itemId             String   @map("item_id") @db.Uuid
  massG              Decimal  @map("mass_g") @db.Decimal(12, 3)
  /// Volume items only: the sample volume in the item's base unit (e.g. ml).
  sampleVolume       Decimal? @map("sample_volume") @db.Decimal(12, 3)
  measuredOn         DateTime @map("measured_on") @db.Date
  method             String
  correctionOfId     String?  @map("correction_of_id") @db.Uuid
  correctionReason   String?  @map("correction_reason")
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedBy         String   @map("recorded_by") @db.Uuid
  operationRequestId String   @unique @map("operation_request_id") @db.Uuid

  item             InventoryItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  correctionOf     ItemReferenceWeight?       @relation("ItemWeightCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections      ItemReferenceWeight[]      @relation("ItemWeightCorrection")
  packageSnapshots CrateCycleWeightSnapshot[] @relation("SnapshotPackageItem")
  recorder         User                       @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  operation        OperationRequest           @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)

  @@index([itemId, recordedAt])
  @@map("item_reference_weights")
}

/// The mass of ONE complete finished bottle (body + content + pump + label) of a product made
/// to ONE recipe version (owner 2026-10-17: a new version is unknown until measured) — the
/// average of `bottles_weighed` bottles. DB: immutable.
model ProductReferenceWeight {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  recipeVersionId    String   @map("recipe_version_id") @db.Uuid
  massG              Decimal  @map("mass_g") @db.Decimal(12, 3)
  bottlesWeighed     Int      @map("bottles_weighed")
  measuredOn         DateTime @map("measured_on") @db.Date
  method             String
  correctionOfId     String?  @map("correction_of_id") @db.Uuid
  correctionReason   String?  @map("correction_reason")
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedBy         String   @map("recorded_by") @db.Uuid
  operationRequestId String   @unique @map("operation_request_id") @db.Uuid

  product       Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipeVersion RecipeVersion              @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  correctionOf  ProductReferenceWeight?    @relation("ProductWeightCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections   ProductReferenceWeight[]   @relation("ProductWeightCorrection")
  recorder      User                       @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  operation     OperationRequest           @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  snapshots     CrateCycleWeightSnapshot[]

  @@index([productId, recipeVersionId, recordedAt])
  @@map("product_reference_weights")
}

/// The tare of an empty crate of a type, including its dividers as described. DB: immutable.
model CrateTypeTareWeight {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  crateTypeId        String   @map("crate_type_id") @db.Uuid
  massG              Decimal  @map("mass_g") @db.Decimal(12, 3)
  /// What the weighed crate consisted of (dividers, inserts …).
  configuration      String
  measuredOn         DateTime @map("measured_on") @db.Date
  method             String
  correctionOfId     String?  @map("correction_of_id") @db.Uuid
  correctionReason   String?  @map("correction_reason")
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedBy         String   @map("recorded_by") @db.Uuid
  operationRequestId String   @unique @map("operation_request_id") @db.Uuid

  crateType    CrateType                  @relation(fields: [crateTypeId], references: [id], onDelete: Restrict)
  correctionOf CrateTypeTareWeight?       @relation("TareCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections  CrateTypeTareWeight[]      @relation("TareCorrection")
  recorder     User                       @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  operation    OperationRequest           @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  snapshots    CrateCycleWeightSnapshot[]

  @@index([crateTypeId, recordedAt])
  @@map("crate_type_tare_weights")
}

enum DimensionSubject {
  /// The crate itself (outer size).
  CRATE
  /// The final shipping package of one crate (one crate = one parcel = one label).
  SHIPPING_PACKAGE
}

enum ExtraPackaging {
  /// The crate ships as it is.
  NONE
  CARTON
  PROTECTIVE_COVER
  OTHER
}

/// Measured outer dimensions (mm) of a crate type or of its final shipping package; for the
/// package also any extra packaging, its mass (unknown allowed) and whether the tare includes it.
/// DB: immutable.
model CrateTypeDimension {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  crateTypeId        String           @map("crate_type_id") @db.Uuid
  subject            DimensionSubject
  lengthMm           Int              @map("length_mm")
  widthMm            Int              @map("width_mm")
  heightMm           Int              @map("height_mm")
  extraPackaging     ExtraPackaging?  @map("extra_packaging")
  extraDescription   String?          @map("extra_description")
  extraMassG         Decimal?         @map("extra_mass_g") @db.Decimal(12, 3)
  /// Or the extra packaging is a catalogue PACKAGING item: its own reference weight is used and
  /// no mass is entered here — the same packaging is never counted twice.
  extraItemId        String?          @map("extra_item_id") @db.Uuid
  extraInTare        Boolean?         @map("extra_in_tare")
  measuredOn         DateTime         @map("measured_on") @db.Date
  method             String
  correctionOfId     String?          @map("correction_of_id") @db.Uuid
  correctionReason   String?          @map("correction_reason")
  recordedAt         DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedBy         String           @map("recorded_by") @db.Uuid
  operationRequestId String           @unique @map("operation_request_id") @db.Uuid

  crateType        CrateType                  @relation(fields: [crateTypeId], references: [id], onDelete: Restrict)
  extraItem        InventoryItem?             @relation("PackagingItem", fields: [extraItemId], references: [id], onDelete: Restrict)
  correctionOf     CrateTypeDimension?        @relation("DimensionCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections      CrateTypeDimension[]       @relation("DimensionCorrection")
  recorder         User                       @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  operation        OperationRequest           @relation(fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  packageSnapshots CrateCycleWeightSnapshot[] @relation("SnapshotPackage")

  shipmentParcels ShipmentParcel[] @relation("ParcelPackage")

  @@index([crateTypeId, subject, recordedAt])
  @@map("crate_type_dimensions")
}

/// The references available at a Hotovo (its CRATE_FILLED event) and the expected weights derived
/// from them; null = unknown then. Later measurements never rewrite it. DB: immutable.
model CrateCycleWeightSnapshot {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cycleId             String   @map("cycle_id") @db.Uuid
  crateEventId        String   @unique @map("crate_event_id") @db.Uuid
  bottles             Int
  productWeightId     String?  @map("product_weight_id") @db.Uuid
  tareWeightId        String?  @map("tare_weight_id") @db.Uuid
  packageId           String?  @map("package_id") @db.Uuid
  /// The packaging item's weight used (extra packaging that is a catalogue item).
  packageItemWeightId String?  @map("package_item_weight_id") @db.Uuid
  /// Sums of many references: a wider range than one measurement (never blocks Hotovo).
  expectedCrateG      Decimal? @map("expected_crate_g") @db.Decimal(20, 3)
  expectedPackageG    Decimal? @map("expected_package_g") @db.Decimal(20, 3)
  takenAt             DateTime @map("taken_at") @db.Timestamptz(3)

  cycle             CrateCycle              @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  crateEvent        CrateEvent              @relation(fields: [crateEventId], references: [id], onDelete: Restrict)
  productWeight     ProductReferenceWeight? @relation(fields: [productWeightId], references: [id], onDelete: Restrict)
  tareWeight        CrateTypeTareWeight?    @relation(fields: [tareWeightId], references: [id], onDelete: Restrict)
  package           CrateTypeDimension?     @relation("SnapshotPackage", fields: [packageId], references: [id], onDelete: Restrict)
  packageItemWeight ItemReferenceWeight?    @relation("SnapshotPackageItem", fields: [packageItemWeightId], references: [id], onDelete: Restrict)

  shipmentParcels ShipmentParcel[]

  @@index([cycleId])
  @@map("crate_cycle_weight_snapshots")
}

// ---------------------------------------------------------------------------------------------
// Dispatch to a carrier (doc 029, owner 2026-10-18): one shipment per completed order (the whole
// order together), one parcel per physical crate (= one label), derived automatically from the
// completed picking. The carrier is behind an interface; nothing is pretended without one.
// ---------------------------------------------------------------------------------------------

enum ShipmentStatus {
  /// Parcels derived; no carrier request yet (actual weighings may be added).
  DRAFT
  /// A carrier request is unresolved (sent, unknown, or labels not yet stored). Blocks everything.
  REQUESTING
  /// The carrier created the shipment and its labels are stored.
  LABELED
  /// Cancellation at the carrier started (recorded before the carrier is called): blocks ready
  /// for pickup and hand-over until the carrier confirms (CANCELLED) or refuses (back).
  CANCELLING
  CANCELLED
}

/// One shipment of one order. DB: one non-cancelled shipment per order; transitions DRAFT →
/// REQUESTING → DRAFT / LABELED, DRAFT → CANCELLED (never at a carrier), LABELED or REQUESTING
/// (shipment created at the carrier) → CANCELLING → back / CANCELLED only with the carrier's
/// confirmation; REQUESTING ⇔ one unresolved carrier request; LABELED ⇔ labels stored and every
/// parcel numbered. The delivery data are the order's immutable snapshot.
model Shipment {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial              BigInt         @unique
  code                String         @unique
  orderId             String         @map("order_id") @db.Uuid
  siteId              String         @map("site_id") @db.Uuid
  status              ShipmentStatus @default(DRAFT)
  /// The carrier, its server-side connection and environment of the requests (snapshot); null
  /// until the first request. Lookups and cancellation always use these, never the current setting.
  carrierCode         String?        @map("carrier_code")
  carrierConnection   String?        @map("carrier_connection")
  carrierEnvironment  String?        @map("carrier_environment")
  /// Fingerprint of the carrier account (ADR 0027): later calls only with this same account.
  carrierAccount      String?        @map("carrier_account")
  carrierShipmentRef  String?        @map("carrier_shipment_ref")
  createdAt           DateTime       @map("created_at") @db.Timestamptz(3)
  createdBy           String         @map("created_by") @db.Uuid
  operationRequestId  String         @map("operation_request_id") @db.Uuid
  labeledAt           DateTime?      @map("labeled_at") @db.Timestamptz(3)
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy         String?        @map("cancelled_by") @db.Uuid
  cancelReason        String?        @map("cancel_reason")
  /// Set only when the carrier confirmed the cancellation of a created shipment.
  carrierCancelledAt  DateTime?      @map("carrier_cancelled_at") @db.Timestamptz(3)
  /// The cancellation at the carrier was started (CANCELLING) — by whom, when; kept afterwards.
  cancelRequestedAt   DateTime?      @map("cancel_requested_at") @db.Timestamptz(3)
  cancelRequestedBy   String?        @map("cancel_requested_by") @db.Uuid
  /// The carrier accepted the cancellation request (asynchronous carriers confirm it later).
  carrierCancelSentAt DateTime?      @map("carrier_cancel_sent_at") @db.Timestamptz(3)

  order           Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  site            Site                     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  creator         User                     @relation("ShipmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  canceller       User?                    @relation("ShipmentCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  cancelRequester User?                    @relation("ShipmentCancelRequestedBy", fields: [cancelRequestedBy], references: [id], onDelete: Restrict)
  operation       OperationRequest         @relation("ShipmentOperation", fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  parcels         ShipmentParcel[]
  requests        ShipmentCarrierRequest[]
  labels          ShipmentLabel[]
  labelFetches    ShipmentLabelFetch[]
  printRequests   PrintRequest[]
  printJobs       PrintJob[]
  tracking        ShipmentTracking?
  trackingEvents  ShipmentTrackingEvent[]
  parcelProgress  ShipmentParcelProgress[]

  @@index([orderId])
  @@map("shipments")
}

/// Tracking schedule of one labelled shipment (doc 031; current state): the next look, the last
/// successful one, consecutive failures and a lease. DB: never deleted; stopped ⇔ no next look.
model ShipmentTracking {
  shipmentId     String    @id @map("shipment_id") @db.Uuid
  nextAt         DateTime? @map("next_at") @db.Timestamptz(3)
  failures       Int       @default(0)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz(3)
  /// A short, secret-free reason of the last failure.
  lastError      String?   @map("last_error")
  /// Parcel numbers the carrier did not return at the last successful look.
  missingNumbers String[]  @default([]) @map("missing_numbers")
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(3)
  stoppedAt      DateTime? @map("stopped_at") @db.Timestamptz(3)
  /// DELIVERED | CANCELLED | GAVE_UP
  stopReason     String?   @map("stop_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@map("shipment_tracking")
}

/// One tracking event of one parcel exactly as the carrier reported it (doc 031; append-only):
/// its numeric status, code, phase, group, wording and time; when AYVO fetched it; our meaning.
/// DB: immutable; one row per parcel × status × code × time (repeated answers add nothing).
model ShipmentTrackingEvent {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId          String   @map("shipment_id") @db.Uuid
  parcelId            String   @map("parcel_id") @db.Uuid
  carrierCode         String   @map("carrier_code")
  carrierEnvironment  String   @map("carrier_environment")
  carrierParcelNumber String   @map("carrier_parcel_number")
  statusId            Int?     @map("status_id")
  code                String?
  phase               String?
  group               String?  @map("event_group")
  name                String?
  /// DATA | PICKED_UP | IN_TRANSIT | DELIVERED | PICKUP_POINT | NOT_DELIVERED | LOST | RETURNING
  /// | CANCELLED | UNKNOWN (doc 031 §2)
  meaning             String
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz(3)
  fetchedAt           DateTime @map("fetched_at") @db.Timestamptz(3)

  shipment   Shipment                 @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  parcel     ShipmentParcel           @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  pickupOf   ShipmentParcelProgress[] @relation("ProgressPickupEvent")
  deliveryOf ShipmentParcelProgress[] @relation("ProgressDeliveryEvent")

  @@index([shipmentId, occurredAt])
  @@map("shipment_tracking_events")
}

/// Where each parcel is (doc 031; current state, only forward): picked up — by the carrier's
/// event, an earlier manual hand-over (MANUAL) or implied by a delivery without a pickup event
/// (CARRIER_IMPLIED, time unknown) — and delivered (by the carrier's delivery event).
model ShipmentParcelProgress {
  parcelId         String    @id @map("parcel_id") @db.Uuid
  shipmentId       String    @map("shipment_id") @db.Uuid
  pickedUpAt       DateTime? @map("picked_up_at") @db.Timestamptz(3)
  /// CARRIER | MANUAL | CARRIER_IMPLIED
  pickedUpSource   String?   @map("picked_up_source")
  pickedUpEventId  String?   @map("picked_up_event_id") @db.Uuid
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(3)
  deliveredEventId String?   @map("delivered_event_id") @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parcel        ShipmentParcel         @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  shipment      Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  pickupEvent   ShipmentTrackingEvent? @relation("ProgressPickupEvent", fields: [pickedUpEventId], references: [id], onDelete: Restrict)
  deliveryEvent ShipmentTrackingEvent? @relation("ProgressDeliveryEvent", fields: [deliveredEventId], references: [id], onDelete: Restrict)

  @@map("shipment_parcel_progress")
}

enum ParcelReferenceSource {
  /// The crate's Hotovo weight snapshot (W1), never rewritten.
  HOTOVO_SNAPSHOT
  /// No Hotovo value: the references in force when the shipment was derived.
  REFERENCE_AT_SHIPMENT
}

/// One physical crate = one parcel = one label. DB: insert only while the shipment is DRAFT, for
/// an active allocation of the shipment's order; immutable except the carrier parcel number (set
/// once). The bottles are the allocation's (never scanned again).
model ShipmentParcel {
  id                  String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId          String                 @map("shipment_id") @db.Uuid
  parcelNo            Int                    @map("parcel_no")
  allocationId        String                 @map("allocation_id") @db.Uuid
  crateId             String                 @map("crate_id") @db.Uuid
  cycleId             String                 @map("cycle_id") @db.Uuid
  /// Calculated reference of the finished package — never an actual weighing.
  referenceWeightG    Decimal?               @map("reference_weight_g") @db.Decimal(20, 3)
  referenceSource     ParcelReferenceSource? @map("reference_source")
  weightSnapshotId    String?                @map("weight_snapshot_id") @db.Uuid
  packageDimensionId  String?                @map("package_dimension_id") @db.Uuid
  carrierParcelNumber String?                @map("carrier_parcel_number")

  shipment         Shipment                  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  allocation       OrderCrateAllocation      @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  crate            Crate                     @relation(fields: [crateId], references: [id], onDelete: Restrict)
  cycle            CrateCycle                @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  weightSnapshot   CrateCycleWeightSnapshot? @relation(fields: [weightSnapshotId], references: [id], onDelete: Restrict)
  packageDimension CrateTypeDimension?       @relation("ParcelPackage", fields: [packageDimensionId], references: [id], onDelete: Restrict)
  weighings        ShipmentParcelWeighing[]
  labels           ShipmentLabel[]
  printRequests    PrintRequest[]
  printJobs        PrintJob[]
  trackingEvents   ShipmentTrackingEvent[]
  progress         ShipmentParcelProgress?

  @@unique([shipmentId, parcelNo])
  @@unique([shipmentId, allocationId])
  @@index([crateId])
  @@map("shipment_parcels")
}

/// An actual weighing of one parcel (optional, append-only; a correction is a new row). Allowed
/// only while the shipment is DRAFT — the carrier receives what was known when labels were made.
model ShipmentParcelWeighing {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parcelId           String   @map("parcel_id") @db.Uuid
  massG              Decimal  @map("mass_g") @db.Decimal(12, 3)
  recordedAt         DateTime @map("recorded_at") @db.Timestamptz(3)
  recordedBy         String   @map("recorded_by") @db.Uuid
  operationRequestId String   @unique @map("operation_request_id") @db.Uuid
  correctionOfId     String?  @unique @map("correction_of_id") @db.Uuid
  correctionReason   String?  @map("correction_reason")

  parcel       ShipmentParcel          @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  recorder     User                    @relation("ParcelWeighedBy", fields: [recordedBy], references: [id], onDelete: Restrict)
  operation    OperationRequest        @relation("ParcelWeighOperation", fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  correctionOf ShipmentParcelWeighing? @relation("ParcelWeighingCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  correctedBy  ShipmentParcelWeighing? @relation("ParcelWeighingCorrection")

  @@index([parcelId, recordedAt])
  @@map("shipment_parcel_weighings")
}

enum CarrierRequestStatus {
  /// Written; not yet handed to the carrier (safe to send).
  PREPARED
  /// Claimed for sending: the carrier may or may not have it — only a lookup resolves it.
  SENT
  /// The carrier acknowledged it (e.g. PPL batch id) and is still processing: poll, never re-send.
  ACCEPTED
  /// The carrier created the shipment; labels not stored yet.
  CREATED
  /// Labels stored.
  SUCCEEDED
  /// The carrier refused it (nothing created).
  REJECTED
  /// A lookup confirmed that the carrier created nothing for it — or a person did, with a reason,
  /// after checking with the carrier (an audited, supervised resolution).
  NOT_CREATED
  /// The carrier created it, its labels never became usable, and the carrier confirmed its
  /// cancellation.
  VOIDED
}

/// One attempt to create the shipment at the carrier, identified by a unique client reference.
/// DB: at most one unresolved (PREPARED / SENT / ACCEPTED / CREATED) per shipment; transitions only forward;
/// the payload sent is kept (no secrets).
model ShipmentCarrierRequest {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId         String               @map("shipment_id") @db.Uuid
  attemptNo          Int                  @map("attempt_no")
  carrierCode        String               @map("carrier_code")
  carrierConnection  String               @map("carrier_connection")
  carrierEnvironment String               @map("carrier_environment")
  carrierAccount     String?              @map("carrier_account")
  clientReference    String               @unique @map("client_reference")
  status             CarrierRequestStatus @default(PREPARED)
  payload            Json
  carrierRef         String?              @map("carrier_ref")
  result             Json?
  errorCode          String?              @map("error_code")
  errorMessage       String?              @map("error_message")
  createdAt          DateTime             @map("created_at") @db.Timestamptz(3)
  createdBy          String               @map("created_by") @db.Uuid
  operationRequestId String               @unique @map("operation_request_id") @db.Uuid
  sentAt             DateTime?            @map("sent_at") @db.Timestamptz(3)
  resolvedAt         DateTime?            @map("resolved_at") @db.Timestamptz(3)
  /// Bounded background polling of an accepted request: when to look next, how often so far.
  nextPollAt         DateTime?            @map("next_poll_at") @db.Timestamptz(3)
  pollCount          Int                  @default(0) @map("poll_count")

  shipment  Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  creator   User             @relation("CarrierRequestBy", fields: [createdBy], references: [id], onDelete: Restrict)
  operation OperationRequest @relation("CarrierRequestOperation", fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  labels    ShipmentLabel[]

  @@unique([shipmentId, attemptNo])
  @@map("shipment_carrier_requests")
}

/// A label file returned by the carrier: one per parcel (its own label) and optionally the
/// complete document of the shipment (parcel null). Stored once; re-printing never contacts the
/// carrier. Generating or downloading it is not evidence of printing.
model ShipmentLabel {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  parcelId   String?  @map("parcel_id") @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  format     String
  dpi        Int?
  fileKey    String   @unique @map("file_key")
  sha256     String
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  /// The carrier's id of this file version (e.g. PPL's data GUID, which changes on every format
  /// change) — no secret. One row per parcel (or complete document), format and dpi (doc 030 §2).
  carrierRef String?  @map("carrier_ref")

  shipment  Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  parcel    ShipmentParcel?        @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  request   ShipmentCarrierRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  printJobs PrintJob[]

  @@index([parcelId])
  @@map("shipment_labels")
}

// ---------------------------------------------------------------------------------------------
// Carrier settings per site (doc 029 §9, doc 022 §8; owner 2026-10-19): PPL only in this stage.
// Secrets never live here: `connection` names a server-side connection whose credentials are in the
// server's protected environment. Configuration (current state) — every change is audited.
// ---------------------------------------------------------------------------------------------

/// The PPL settings of one site. May be saved incomplete; a new shipment needs them complete,
/// enabled and verified with the same connection.
model SiteCarrierSetting {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  siteId             String    @unique @map("site_id") @db.Uuid
  carrier            String
  enabled            Boolean   @default(false)
  /// A server-side connection code (e.g. PPL_TEST); never a URL, never a secret.
  connection         String?
  senderName         String?   @map("sender_name")
  senderStreet       String?   @map("sender_street")
  senderCity         String?   @map("sender_city")
  senderPostalCode   String?   @map("sender_postal_code")
  senderCountry      String?   @map("sender_country") @db.Char(2)
  senderContact      String?   @map("sender_contact")
  senderPhone        String?   @map("sender_phone")
  senderEmail        String?   @map("sender_email")
  /// The carrier's product code, chosen from the list verified with `verified_connection`.
  productCode        String?   @map("product_code")
  /// SINGLE = one label per parcel (thermal printer); A4 = also a complete A4 document.
  /// Kept for the previous application (PRINT38-R1, rollback); always PDF / 203 since doc 030 —
  /// the format and resolution of printed labels belong to the printer.
  labelFormat        String    @default("PDF") @map("label_format")
  labelDpi           Int       @default(203) @map("label_dpi")
  labelLayout        String    @default("SINGLE") @map("label_layout")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedConnection String?   @map("verified_connection")
  /// The carrier's product list as read during the verification (code + name).
  verifiedProducts   Json?     @map("verified_products")
  /// The carrier account fingerprint the verification was made with (ADR 0027).
  verifiedAccount    String?   @map("verified_account")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy          String    @map("updated_by") @db.Uuid

  site     Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  verifier User? @relation("CarrierSettingVerifiedBy", fields: [verifiedBy], references: [id], onDelete: Restrict)
  updater  User  @relation("CarrierSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("site_carrier_settings")
}

/// Credentials of a server-side carrier connection entered in the administration (ADR 0027): the
/// secret only encrypted (AES-256-GCM, key in the server environment). Replaced, never deleted,
/// never returned by the API. Only the TEST environment exists in this stage.
model CarrierConnection {
  code             String   @id
  carrier          String
  environment      String
  clientId         String   @map("client_id")
  account          String
  secretCiphertext Bytes    @map("secret_ciphertext")
  secretIv         Bytes    @map("secret_iv")
  secretTag        Bytes    @map("secret_tag")
  keyId            String   @map("key_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy        String   @map("updated_by") @db.Uuid

  updater User @relation("CarrierConnectionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("carrier_connections")
}

// ---------------------------------------------------------------------------------------------
// Direct printing (doc 030, ADR 0028): label variants, print agents and printers per site, the
// durable print queue. The database keeps the rules (triggers in 20261020090100_direct_printing).
// ---------------------------------------------------------------------------------------------

/// Fetching a further label variant (ZPL at a printer's dpi) of a labelled shipment: current state,
/// leased (one fetch per shipment at a time — the carrier's batch format is shared), bounded.
model ShipmentLabelFetch {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId   String    @map("shipment_id") @db.Uuid
  format       String
  dpi          Int
  /// PENDING (to fetch, see next_at) | DONE | FAILED (attempts exhausted or the carrier's file
  /// did not prove its parcel — a person decides).
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  nextAt       DateTime? @map("next_at") @db.Timestamptz(3)
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz(3)
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, format, dpi])
  @@index([status, nextAt])
  @@map("shipment_label_fetches")
}

/// A print agent (Raspberry Pi) of one site: a machine principal, never a user (ADR 0028). Only
/// the SHA-256 hash of its token is stored; the token is shown once.
model PrintAgent {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code            String    @unique
  name            String
  siteId          String    @map("site_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  /// The token's last 4 characters, to recognise it — never the token.
  tokenHint       String    @map("token_hint")
  tokenIssuedAt   DateTime  @map("token_issued_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy       String?   @map("revoked_by") @db.Uuid
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(3)
  lastVersion     String?   @map("last_version")
  /// The USB printers the agent last found (serial, product) — only offered to an ADMIN, never
  /// assigned or enabled by themselves.
  detectedDevices Json?     @map("detected_devices")
  detectedAt      DateTime? @map("detected_at") @db.Timestamptz(3)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.Uuid

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  creator  User            @relation("PrintAgentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revoker  User?           @relation("PrintAgentRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)
  printers Printer[]
  jobs     PrintJob[]
  events   PrintJobEvent[]

  @@unique([id, siteId])
  @@map("print_agents")
}

/// A physical printer of a site, attached by USB to one print agent of the same site. Only the
/// Zebra ZD220 DT (ZPL, 203 dpi) is supported; the media size is not assumed (doc 030 §3).
model Printer {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code            String    @unique
  name            String
  siteId          String    @map("site_id") @db.Uuid
  agentId         String    @map("agent_id") @db.Uuid
  model           String
  language        String
  dpi             Int
  connection      String
  usbSerial       String    @map("usb_serial")
  dispatchDefault Boolean   @default(false) @map("dispatch_default")
  autoPrint       Boolean   @default(false) @map("auto_print")
  enabled         Boolean   @default(true)
  /// As the agent last reported it (READY | NOT_FOUND | ERROR) — never assumed.
  reportedState   String?   @map("reported_state")
  reportedDetail  String?   @map("reported_detail")
  reportedAt      DateTime? @map("reported_at") @db.Timestamptz(3)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.Uuid
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)
  updatedBy       String    @map("updated_by") @db.Uuid

  site     Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  agent    PrintAgent     @relation(fields: [agentId, siteId], references: [id, siteId], onDelete: Restrict)
  creator  User           @relation("PrinterCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User           @relation("PrinterUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  requests PrintRequest[]
  jobs     PrintJob[]

  @@unique([agentId, usbSerial])
  @@index([siteId])
  @@map("printers")
}

/// The operator's decision to print (the shipment's labels, or one parcel again) on a printer
/// fixed at that moment. Waits for the ZPL variant, then becomes one job per parcel.
model PrintRequest {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  siteId                String    @map("site_id") @db.Uuid
  orderId               String    @map("order_id") @db.Uuid
  shipmentId            String    @map("shipment_id") @db.Uuid
  parcelId              String?   @map("parcel_id") @db.Uuid
  printerId             String    @map("printer_id") @db.Uuid
  /// SHIPMENT (every parcel) | REPRINT (one parcel, with a reason).
  kind                  String
  /// WAITING_FOR_LABELS | QUEUED (jobs created) | CANCELLED (the shipment's cancellation).
  status                String    @default("WAITING_FOR_LABELS")
  reason                String?
  duplicateAcknowledged Boolean   @default(false) @map("duplicate_acknowledged")
  requestedAt           DateTime  @map("requested_at") @db.Timestamptz(3)
  requestedBy           String    @map("requested_by") @db.Uuid
  operationRequestId    String    @unique @map("operation_request_id") @db.Uuid
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz(3)

  site      Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment  Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  parcel    ShipmentParcel?  @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  printer   Printer          @relation(fields: [printerId], references: [id], onDelete: Restrict)
  requester User             @relation("PrintRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  operation OperationRequest @relation("PrintRequestOperation", fields: [operationRequestId], references: [requestId], onDelete: Restrict)
  jobs      PrintJob[]

  @@index([shipmentId])
  @@map("print_requests")
}

/// One parcel label on its way to one printer (ADR 0028). QUEUED → CLAIMED → SENDING → SENT |
/// FAILED | UNCERTAIN; QUEUED/CLAIMED → CANCELLED. SENT = all bytes written to the device — never
/// proof of a printed or applied label.
model PrintJob {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial         BigInt    @unique
  code           String    @unique
  siteId         String    @map("site_id") @db.Uuid
  printRequestId String    @map("print_request_id") @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  shipmentId     String    @map("shipment_id") @db.Uuid
  parcelId       String    @map("parcel_id") @db.Uuid
  labelId        String    @map("label_id") @db.Uuid
  /// The stored ZPL file of that label (checked against it by the database at creation).
  fileKey        String    @map("file_key")
  sha256         String
  sizeBytes      Int       @map("size_bytes")
  printerId      String    @map("printer_id") @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  status         String    @default("QUEUED")
  claimToken     String?   @map("claim_token")
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  detail         String?
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  request  PrintRequest    @relation(fields: [printRequestId], references: [id], onDelete: Restrict)
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  parcel   ShipmentParcel  @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  label    ShipmentLabel   @relation(fields: [labelId], references: [id], onDelete: Restrict)
  printer  Printer         @relation(fields: [printerId], references: [id], onDelete: Restrict)
  agent    PrintAgent      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  events   PrintJobEvent[]

  @@unique([printRequestId, parcelId])
  @@index([agentId, status])
  @@index([shipmentId])
  @@index([parcelId])
  @@map("print_jobs")
}

/// The append-only history of a print job (who or which agent, what, when).
model PrintJobEvent {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  status      String
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  agentId     String?  @map("agent_id") @db.Uuid
  detail      String?

  job   PrintJob    @relation(fields: [jobId], references: [id], onDelete: Restrict)
  actor User?       @relation("PrintJobEventBy", fields: [actorUserId], references: [id], onDelete: Restrict)
  agent PrintAgent? @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([jobId, occurredAt])
  @@map("print_job_events")
}

/// The supply plan of one hotel (doc 032; current state, every change audited): validity,
/// INACTIVE → ACTIVE ⇄ PAUSED, its rules. DB: never deleted; hotel and site immutable.
model SupplyPlan {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  hotelId      String    @unique @map("hotel_id") @db.Uuid
  siteId       String    @map("site_id") @db.Uuid
  /// INACTIVE | ACTIVE | PAUSED
  status       String    @default("INACTIVE")
  version      Int       @default(1)
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String    @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy    String    @map("updated_by") @db.Uuid
  activatedAt  DateTime? @map("activated_at") @db.Timestamptz(3)
  activatedBy  String?   @map("activated_by") @db.Uuid
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastRunOkAt  DateTime? @map("last_run_ok_at") @db.Timestamptz(3)
  lastRunError String?   @map("last_run_error")

  hotel       Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  site        Site                   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  creator     User                   @relation("SupplyPlanCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     User                   @relation("SupplyPlanUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  activator   User?                  @relation("SupplyPlanActivatedBy", fields: [activatedBy], references: [id], onDelete: Restrict)
  rules       SupplyPlanRule[]
  occurrences SupplyPlanOccurrence[]

  @@index([siteId, status])
  @@map("supply_plans")
}

/// A rule of a plan: product × whole crates × days of the month (1–31).
model SupplyPlanRule {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId    String @map("plan_id") @db.Uuid
  position  Int
  productId String @map("product_id") @db.Uuid
  crates    Int
  days      Int[]  @db.SmallInt

  plan    SupplyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([planId, position])
  @@map("supply_plan_rules")
}

/// One occurrence of a plan = one local ship day (doc 032). DB: unique per plan and day (any
/// version); ORDERED is final; BLOCKED holds the reason.
model SupplyPlanOccurrence {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  shipDate      DateTime @map("ship_date") @db.Date
  /// ORDERED | BLOCKED
  status        String
  orderId       String?  @unique @map("order_id") @db.Uuid
  planVersion   Int      @map("plan_version")
  snapshot      Json
  blockedCode   String?  @map("blocked_code")
  blockedDetail String?  @map("blocked_detail")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  plan        SupplyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  order       Order?     @relation("OccurrenceOrder", fields: [orderId], references: [id], onDelete: Restrict)
  originOrder Order?     @relation("OrderOfOccurrence")

  @@unique([planId, shipDate])
  @@map("supply_plan_occurrences")
}

// =============================================================================================
// sales module — Obchod: hotel acquisition (doc 034, ADR 0031). Prospects are not hotels.
// =============================================================================================

/// A hotel prospect (current state; every change is a SalesEvent in the same transaction).
model SalesProspect {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial            BigInt    @unique
  code              String    @unique
  name              String
  nameKey           String    @map("name_key")
  countryCode       String    @map("country_code") @db.Char(2)
  city              String?
  addressLine1      String?   @map("address_line1")
  addressLine2      String?   @map("address_line2")
  postalCode        String?   @map("postal_code")
  /// An estimate; unknown = null, never 0.
  roomsEstimate     Int?      @map("rooms_estimate")
  /// HOTEL | PENSION | APARTMENTS | HOSTEL | OTHER
  accommodationType String?   @map("accommodation_type")
  website           String?
  websiteKey        String?   @map("website_key")
  source            String?
  ownerId           String    @map("owner_id") @db.Uuid
  /// A | B | C
  priority          String?
  /// NEW | CONTACTED | NEGOTIATION | OFFER | WON | LOST
  stage             String    @default("NEW")
  lostReason        String?   @map("lost_reason")
  note              String?
  revision          Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String    @map("created_by") @db.Uuid
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy         String    @map("updated_by") @db.Uuid
  /// Archived (not a stage): no new work until restored; nothing is deleted (doc 034 §3a).
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedBy        String?   @map("archived_by") @db.Uuid
  archiveReason     String?   @map("archive_reason")
  /// The confirmed CSV import (and its spreadsheet row) the prospect came from; immutable.
  importId          String?   @map("import_id") @db.Uuid
  importRow         Int?      @map("import_row")

  owner      User            @relation("SalesProspectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  archiver   User?           @relation("SalesProspectArchivedBy", fields: [archivedBy], references: [id], onDelete: Restrict)
  import     SalesImport?    @relation(fields: [importId], references: [id], onDelete: Restrict)
  creator    User            @relation("SalesProspectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    User            @relation("SalesProspectUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  contacts   SalesContact[]
  activities SalesActivity[]
  tasks      SalesTask[]
  events     SalesEvent[]

  @@unique([importId, importRow])
  @@index([ownerId])
  @@index([nameKey])
  @@index([websiteKey])
  @@map("sales_prospects")
}

/// A confirmed CSV import of prospects (doc 034 §13): append-only; the file is never stored.
model SalesImport {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial       BigInt   @unique
  code         String   @unique
  fileName     String   @map("file_name")
  fileSha256   String   @map("file_sha256")
  encoding     String
  delimiter    String
  rowCount     Int      @map("row_count")
  createdCount Int      @map("created_count")
  ownerId      String   @map("owner_id") @db.Uuid
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  requestId    String   @unique @map("request_id") @db.Uuid
  /// [{ row, errors: [code] }] — never contact data.
  skipped      Json

  owner     User            @relation("SalesImportOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator   User            @relation("SalesImportCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  prospects SalesProspect[]

  @@index([createdBy, createdAt])
  @@map("sales_imports")
}

/// A contact of a prospect: a person or a designation ("Recepce"). Retired, never deleted.
model SalesContact {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  prospectId   String    @map("prospect_id") @db.Uuid
  label        String
  position     String?
  email        String?
  emailKey     String?   @map("email_key")
  phone        String?
  phoneKey     String?   @map("phone_key")
  note         String?
  isPrimary    Boolean   @default(false) @map("is_primary")
  revision     Int       @default(1)
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredBy    String?   @map("retired_by") @db.Uuid
  retireReason String?   @map("retire_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String    @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy    String    @map("updated_by") @db.Uuid

  prospect   SalesProspect   @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  retirer    User?           @relation("SalesContactRetiredBy", fields: [retiredBy], references: [id], onDelete: Restrict)
  creator    User            @relation("SalesContactCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    User            @relation("SalesContactUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  activities SalesActivity[]
  tasks      SalesTask[]
  events     SalesEvent[]

  @@unique([id, prospectId])
  @@index([prospectId])
  @@index([emailKey])
  @@index([phoneKey])
  @@map("sales_contacts")
}

/// What happened (append-only). A correction or withdrawal is a new row pointing to the old one.
model SalesActivity {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  prospectId       String   @map("prospect_id") @db.Uuid
  /// CALL | EMAIL_SENT | EMAIL_RECEIVED | MEETING | SAMPLES | OFFER | NOTE
  kind             String
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  authorId         String   @map("author_id") @db.Uuid
  contactId        String?  @map("contact_id") @db.Uuid
  content          String?
  outcome          String?
  correctsId       String?  @unique @map("corrects_id") @db.Uuid
  correctionReason String?  @map("correction_reason")
  withdrawn        Boolean  @default(false)
  requestId        String   @unique @map("request_id") @db.Uuid

  prospect    SalesProspect   @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  author      User            @relation("SalesActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  contact     SalesContact?   @relation(fields: [contactId, prospectId], references: [id, prospectId], onDelete: Restrict, map: "sales_activities_contact_id_prospect_id_fkey")
  corrects    SalesActivity?  @relation("SalesActivityCorrection", fields: [correctsId, prospectId], references: [id, prospectId], onDelete: Restrict, map: "sales_activities_corrects_id_prospect_id_fkey")
  correctedBy SalesActivity[] @relation("SalesActivityCorrection")

  @@unique([id, prospectId])
  @@index([prospectId, occurredAt])
  @@map("sales_activities")
}

/// What someone will do (current state; changes are SalesEvents).
model SalesTask {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  prospectId String    @map("prospect_id") @db.Uuid
  contactId  String?   @map("contact_id") @db.Uuid
  title      String
  note       String?
  assigneeId String    @map("assignee_id") @db.Uuid
  /// A calendar day in the sales time zone (Europe/Prague).
  dueOn      DateTime  @map("due_on") @db.Date
  /// OPEN | DONE | CANCELLED
  status     String    @default("OPEN")
  result     String?
  revision   Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String    @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy  String    @map("updated_by") @db.Uuid
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy   String?   @map("closed_by") @db.Uuid

  prospect SalesProspect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  contact  SalesContact? @relation(fields: [contactId, prospectId], references: [id, prospectId], onDelete: Restrict, map: "sales_tasks_contact_id_prospect_id_fkey")
  assignee User          @relation("SalesTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator  User          @relation("SalesTaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User          @relation("SalesTaskUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  closer   User?         @relation("SalesTaskClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  events   SalesEvent[]

  @@unique([id, prospectId])
  @@index([prospectId])
  @@map("sales_tasks")
}

/// Append-only history of every change of a prospect, its contacts and tasks.
model SalesEvent {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  type       String
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String   @map("actor_id") @db.Uuid
  contactId  String?  @map("contact_id") @db.Uuid
  taskId     String?  @map("task_id") @db.Uuid
  payload    Json
  requestId  String   @map("request_id") @db.Uuid

  prospect SalesProspect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  actor    User          @relation("SalesEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  contact  SalesContact? @relation(fields: [contactId, prospectId], references: [id, prospectId], onDelete: Restrict, map: "sales_events_contact_id_prospect_id_fkey")
  task     SalesTask?    @relation(fields: [taskId, prospectId], references: [id, prospectId], onDelete: Restrict, map: "sales_events_task_id_prospect_id_fkey")

  @@index([prospectId, occurredAt])
  @@index([taskId])
  @@map("sales_events")
}
