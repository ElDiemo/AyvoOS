// AYVO OS database schema.
//
// PostgreSQL is the source of truth (ADR 0002). Prisma conventions: ADR 0009.
// Lifecycle history is append-only (ADR 0006).
//
// Milestone 1 (bottles, label templates, printing v0.1) and Milestone 2A (inventory foundation,
// supplier receiving, physical label application — doc 018) and Milestone 2C (identity and
// access — ADR 0022, doc 021) add the models below. Crates,
// products, fill batches, hotels, deliveries, billing and ESG are still NOT modelled.
//
// Invariants that Prisma cannot express live as raw SQL in the migrations and are listed in the
// comments of each model ("DB:"). Data dictionary: docs/015-data-dictionary.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Shared infrastructure
// ---------------------------------------------------------------------------------------------

/// Gapless counters for human-readable codes (AYV-B-…, BC-…, PJ-…). A range is allocated with
/// `UPDATE … SET last_value = last_value + n RETURNING last_value` inside the business
/// transaction: the row lock serialises concurrent allocations, and a rollback returns the range.
/// DB: rows are seeded by the migration; CHECK last_value >= 0.
model CodeCounter {
  name      String @id
  lastValue BigInt @default(0) @map("last_value")

  @@map("code_counters")
}

// ---------------------------------------------------------------------------------------------
// labels module — label templates, immutable versions, artwork
// ---------------------------------------------------------------------------------------------

enum LabelArtworkFormat {
  SVG
  PNG
  JPEG
}

/// Uploaded background artwork. The bytes live in file storage (storageKey), never in PostgreSQL.
/// DB: immutable (UPDATE/DELETE rejected by trigger).
model LabelArtwork {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  format           LabelArtworkFormat
  contentType      String             @map("content_type")
  byteSize         Int                @map("byte_size")
  sha256           String             @db.Char(64)
  /// Server-generated storage key; never derived from the uploaded filename.
  storageKey       String             @unique @map("storage_key")
  /// Informational only (sanitised); never used for storage paths.
  originalFilename String             @map("original_filename")
  /// Intrinsic proportions of the artwork (pixels for PNG/JPEG, user units for SVG).
  intrinsicWidth   Float              @map("intrinsic_width")
  intrinsicHeight  Float              @map("intrinsic_height")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  versions LabelTemplateVersion[]

  @@map("label_artworks")
}

/// Logical, reusable label design (e.g. "mydlo1"). Not a Product. Never deleted.
/// DB: name/id/created_at immutable and DELETE rejected (triggers).
model LabelTemplate {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// DB: unique, CHECK name matches ^[a-z0-9][a-z0-9_-]{0,63}$.
  name       String    @unique
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Archived templates stay available for historical reproduction but cannot be used for new
  /// creation batches. NULL = active.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  versions LabelTemplateVersion[]

  @@map("label_templates")
}

/// Immutable snapshot of a label design. Print output is fully reproducible from a version.
/// DB: immutable (UPDATE/DELETE rejected by trigger); UNIQUE (template_id, version_number);
/// CHECK physical size 10–500 mm.
model LabelTemplateVersion {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  versionNumber Int      @map("version_number")
  widthMm       Decimal  @map("width_mm") @db.Decimal(6, 2)
  heightMm      Decimal  @map("height_mm") @db.Decimal(6, 2)
  artworkId     String   @map("artwork_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template        LabelTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  artwork         LabelArtwork           @relation(fields: [artworkId], references: [id], onDelete: Restrict)
  elements        LabelTemplateElement[]
  creationBatches BottleCreationBatch[]
  printJobs       LabelPrintJob[]

  @@unique([templateId, versionNumber])
  @@map("label_template_versions")
}

/// Element types a label layout may contain. v0.1 implements QR_CODE only; future types
/// (BOTTLE_CODE, TEXT, BARCODE, BATCH_CODE) are added to this enum by a later migration.
enum LabelElementType {
  QR_CODE
}

/// One positioned element of a template version, in physical millimetres. Origin: top-left
/// corner of the label, x to the right, y downwards. For QR_CODE the box includes the quiet zone.
/// DB: immutable (trigger); CHECK x,y >= 0, width,height > 0; QR_CODE is square; rotation 0 (v0.1).
model LabelTemplateElement {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  versionId   String           @map("version_id") @db.Uuid
  type        LabelElementType
  /// Drawing order within the version (0 = first/bottom).
  position    Int
  xMm         Decimal          @map("x_mm") @db.Decimal(6, 2)
  yMm         Decimal          @map("y_mm") @db.Decimal(6, 2)
  widthMm     Decimal          @map("width_mm") @db.Decimal(6, 2)
  heightMm    Decimal          @map("height_mm") @db.Decimal(6, 2)
  rotationDeg Int              @default(0) @map("rotation_deg")
  /// Type-specific settings for future element types (validated by Zod in the labels module).
  properties  Json             @default("{}")

  version LabelTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, position])
  @@map("label_template_elements")
}

// ---------------------------------------------------------------------------------------------
// assets module — bottles, lifecycle events, creation batches
// ---------------------------------------------------------------------------------------------

/// Current status of a bottle (current-state column, ADR 0006). v0.1: CREATED only.
enum BottleStatus {
  CREATED
  /// The printed QR label is physically on the bottle body; the body is empty (doc 018).
  LABELED_EMPTY
}

/// Lifecycle event types. FILLED, ASSIGNED_TO_CRATE, … are added in later phases.
enum BottleEventType {
  CREATED
  /// First physical label installation; consumes one NEW_BOTTLE unit of the selected lot (doc 018).
  LABEL_APPLIED
}

/// A group of physical bottle identities registered in one operation (NOT a fill batch).
/// DB: immutable (trigger); CHECK quantity 1–1000, quantity_created = quantity_requested,
/// last_bottle_serial - first_bottle_serial + 1 = quantity_created; code derived from serial.
model BottleCreationBatch {
  id                     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial                 BigInt   @unique
  /// "BC-000001"
  code                   String   @unique
  /// Client-generated idempotency key of the registration request: a retried request with the
  /// same key returns this batch instead of creating a second one. DB: unique (NULL only for
  /// rows created before the column existed).
  clientRequestId        String?  @unique @map("client_request_id") @db.Uuid
  quantityRequested      Int      @map("quantity_requested")
  quantityCreated        Int      @map("quantity_created")
  /// Label template version selected at registration (cross-module FK to labels; integrity only).
  labelTemplateVersionId String   @map("label_template_version_id") @db.Uuid
  firstBottleSerial      BigInt   @map("first_bottle_serial")
  lastBottleSerial       BigInt   @map("last_bottle_serial")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  labelTemplateVersion LabelTemplateVersion @relation(fields: [labelTemplateVersionId], references: [id], onDelete: Restrict)
  bottles              Bottle[]
  events               BottleEvent[]
  printJobs            LabelPrintJob[]

  @@index([labelTemplateVersionId])
  @@map("bottle_creation_batches")
}

/// A physical reusable bottle. Never deleted.
/// DB: DELETE rejected; identity columns (serial, code, public_token, creation_batch_id,
/// created_at) immutable (trigger); code derived from serial (CHECK); public_token unique and
/// 22 URL-safe characters (CHECK).
model Bottle {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial          BigInt       @unique
  /// Human-readable, sequential: "AYV-B-000001". Not a security token.
  code            String       @unique
  /// Opaque public QR identity (128 random bits, base64url). Never derived from id or code.
  publicToken     String       @unique @map("public_token")
  status          BottleStatus
  creationBatchId String       @map("creation_batch_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  creationBatch BottleCreationBatch         @relation(fields: [creationBatchId], references: [id], onDelete: Restrict)
  events        BottleEvent[]
  printJobItems LabelPrintJobItem[]
  components    BottleComponentAttachment[]

  @@index([creationBatchId, serial])
  @@map("bottles")
}

/// Append-only lifecycle history (ADR 0006).
/// DB: UPDATE/DELETE rejected by trigger; at most one CREATED event per bottle (partial unique).
model BottleEvent {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bottleId        String          @map("bottle_id") @db.Uuid
  type            BottleEventType
  /// When it physically happened vs. when the system recorded it (doc 002, "Time").
  occurredAt      DateTime        @map("occurred_at") @db.Timestamptz(3)
  recordedAt      DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Acting user. NULL until the identity-access module exists (no authentication in v0.1).
  actorId         String?         @map("actor_id") @db.Uuid
  /// Context reference for CREATED events. Later event types add their own nullable references.
  creationBatchId String?         @map("creation_batch_id") @db.Uuid
  /// Small event-specific data, validated by Zod in the assets module.
  payload         Json            @default("{}")

  bottle        Bottle                      @relation(fields: [bottleId], references: [id], onDelete: Restrict)
  creationBatch BottleCreationBatch?        @relation(fields: [creationBatchId], references: [id], onDelete: Restrict)
  movements     InventoryMovement[]
  installations BottleComponentAttachment[] @relation("ComponentInstalledBy")
  removals      BottleComponentAttachment[] @relation("ComponentRemovedBy")

  @@index([bottleId, occurredAt])
  @@map("bottle_events")
}

// ---------------------------------------------------------------------------------------------
// label-production module — print jobs
// ---------------------------------------------------------------------------------------------

/// Runtime environment that created a print job (APP_ENV). Decides the QR URL policy and the
/// DEV marker on labels (ADR 0014).
enum AppEnvironment {
  development
  test
  production
}

/// QR error correction level used for a print job (ISO/IEC 18004).
enum QrErrorCorrectionLevel {
  L
  M
  Q
  H
}

enum LabelPrintJobStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

/// One concrete rendering of labels for a fixed set of bottles with a fixed template version.
/// Its status is current state (operational job), not bottle lifecycle history.
/// DB: identity columns immutable (trigger); DELETE rejected; label_count > 0.
model LabelPrintJob {
  id                     String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial                 BigInt                 @unique
  /// "PJ-000001"
  code                   String                 @unique
  creationBatchId        String                 @map("creation_batch_id") @db.Uuid
  labelTemplateVersionId String                 @map("label_template_version_id") @db.Uuid
  labelCount             Int                    @map("label_count")
  /// Public QR base URL used for every QR of this job (snapshot, so retries are identical).
  /// DB: QR environment CHECK by parsed host (production QR host only in production, ADR 0014).
  publicBaseUrl          String                 @map("public_base_url")
  /// Environment of the process that created the job.
  appEnvironment         AppEnvironment         @map("app_environment")
  /// QR error correction level printed by this job (snapshot of configuration).
  qrErrorCorrection      QrErrorCorrectionLevel @map("qr_error_correction")
  status                 LabelPrintJobStatus    @default(PENDING)
  attempts               Int                    @default(0)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt              DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt            DateTime?              @map("completed_at") @db.Timestamptz(3)
  failedAt               DateTime?              @map("failed_at") @db.Timestamptz(3)
  /// Safe, user-facing failure summary (no paths, no stack traces).
  failureReason          String?                @map("failure_reason")
  fileStorageKey         String?                @map("file_storage_key")
  fileByteSize           Int?                   @map("file_byte_size")
  fileSha256             String?                @map("file_sha256") @db.Char(64)

  creationBatch        BottleCreationBatch  @relation(fields: [creationBatchId], references: [id], onDelete: Restrict)
  labelTemplateVersion LabelTemplateVersion @relation(fields: [labelTemplateVersionId], references: [id], onDelete: Restrict)
  items                LabelPrintJobItem[]

  @@index([creationBatchId])
  @@map("label_print_jobs")
}

/// The exact bottles of a print job, in page order (page = position + 1).
/// DB: immutable (trigger); UNIQUE (print_job_id, position) and (print_job_id, bottle_id).
model LabelPrintJobItem {
  printJobId String @map("print_job_id") @db.Uuid
  position   Int
  bottleId   String @map("bottle_id") @db.Uuid
  /// The exact URL encoded in this label's QR code (base URL + public token at job creation).
  qrUrl      String @map("qr_url")

  printJob    LabelPrintJob               @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  bottle      Bottle                      @relation(fields: [bottleId], references: [id], onDelete: Restrict)
  attachments BottleComponentAttachment[]

  @@id([printJobId, position])
  @@unique([printJobId, bottleId])
  @@index([bottleId])
  @@map("label_print_job_items")
}

/// Installation history of a bottle's replaceable components (doc 018 §15). The identity belongs
/// to the bottle body; components come and go. LABEL now; PUMP and others later.
/// DB: insert-only except one close (removed_* NULL → values); at most one open attachment per
/// (bottle, component_type) (partial unique); LABEL requires label_qr_url + print job item of the
/// same bottle with the same URL and an installing LABEL_APPLIED event of the same bottle;
/// removal fields all-or-none; DELETE rejected.
model BottleComponentAttachment {
  id               String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bottleId         String                @map("bottle_id") @db.Uuid
  componentType    ComponentType         @map("component_type")
  /// LABEL: the exact QR URL scanned at installation.
  labelQrUrl       String?               @map("label_qr_url")
  /// LABEL: the print job item the label came from (most recent COMPLETED job of the identity).
  printJobId       String?               @map("print_job_id") @db.Uuid
  printJobPosition Int?                  @map("print_job_position")
  installedAt      DateTime              @map("installed_at") @db.Timestamptz(3)
  installedBy      String?               @map("installed_by") @db.Uuid
  installedEventId String                @map("installed_event_id") @db.Uuid
  removedAt        DateTime?             @map("removed_at") @db.Timestamptz(3)
  removedBy        String?               @map("removed_by") @db.Uuid
  removalReason    String?               @map("removal_reason")
  disposition      ComponentDisposition?
  removalEventId   String?               @map("removal_event_id") @db.Uuid

  bottle         Bottle             @relation(fields: [bottleId], references: [id], onDelete: Restrict)
  printJobItem   LabelPrintJobItem? @relation(fields: [printJobId, printJobPosition], references: [printJobId, position], onDelete: Restrict)
  installedEvent BottleEvent        @relation("ComponentInstalledBy", fields: [installedEventId], references: [id], onDelete: Restrict)
  removalEvent   BottleEvent?       @relation("ComponentRemovedBy", fields: [removalEventId], references: [id], onDelete: Restrict)

  @@index([bottleId])
  @@index([installedEventId])
  @@index([printJobId, printJobPosition])
  @@map("bottle_component_attachments")
}

enum ComponentType {
  LABEL
}

/// What happens to a removed component (removal workflows are deferred; doc 018 §16).
enum ComponentDisposition {
  REUSED
  SCRAPPED
  QUARANTINED
  CLEANING_REQUIRED
  RETURNED_TO_SUPPLIER
}

// ---------------------------------------------------------------------------------------------
// inventory module — items, units, locations, lots, ledger, balances, consumption rules (doc 018)
// ---------------------------------------------------------------------------------------------

enum UnitDimension {
  COUNT
  VOLUME
  MASS
}

/// Reference data. DB: code pattern; decimal_places 0–3; immutable; DELETE rejected.
model InventoryUnit {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// "pcs", "ml", "g", "sheet", "roll"
  code          String        @unique
  name          String
  dimension     UnitDimension
  /// Quantities in this unit may have at most this many decimals ("pcs" = 0: whole pieces).
  decimalPlaces Int           @map("decimal_places") @db.SmallInt

  items InventoryItem[]

  @@map("inventory_units")
}

enum InventoryItemKind {
  NEW_BOTTLE
  PUMP
  LABEL_MEDIA
  BULK_LIQUID
  PACKAGING
  COMPONENT
}

enum LotTracking {
  NONE
  REQUIRED
}

/// Catalogue entry of quantity-tracked material. Creating an item is never a receipt.
/// DB: code pattern; identity (code, kind, base_unit_id, lot_tracking, created_at) immutable;
/// DELETE rejected. (id, base_unit_id) unique: target of composite FKs that force every
/// quantity of the item into its base unit.
model InventoryItem {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Language-neutral SKU, e.g. "NEW_BOTTLE".
  code        String            @unique
  name        String
  kind        InventoryItemKind
  baseUnitId  String            @map("base_unit_id") @db.Uuid
  lotTracking LotTracking       @map("lot_tracking")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(3)

  baseUnit     InventoryUnit          @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  settings     InventoryItemSetting[]
  lots         InventoryLot[]
  receiptLines GoodsReceiptLine[]
  movements    InventoryMovement[]
  balances     InventoryBalance[]
  bomLines     BomLine[]

  @@unique([id, baseUnitId])
  @@map("inventory_items")
}

/// Append-only planning settings of an item; the highest version is current.
/// DB: immutable; version >= 1; quantities >= 0 in the item's unit scale; target >= reorder point.
model InventoryItemSetting {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  version             Int
  reorderPoint        Decimal? @map("reorder_point") @db.Decimal(19, 3)
  targetLevel         Decimal? @map("target_level") @db.Decimal(19, 3)
  preferredSupplierId String?  @map("preferred_supplier_id") @db.Uuid
  leadTimeDays        Int?     @map("lead_time_days")
  purchaseMultiple    Decimal? @map("purchase_multiple") @db.Decimal(19, 3)
  validFrom           DateTime @default(now()) @map("valid_from") @db.Timestamptz(3)
  actorId             String?  @map("actor_id") @db.Uuid
  requestId           String   @unique @map("request_id") @db.Uuid

  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  preferredSupplier Supplier?     @relation(fields: [preferredSupplierId], references: [id], onDelete: Restrict)

  @@unique([itemId, version])
  @@map("inventory_item_settings")
}

/// Physical stock location. One ("MAIN") for now. DB: code pattern; DELETE rejected.
model InventoryLocation {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code String @unique
  name String

  movements  InventoryMovement[]
  balances   InventoryBalance[]
  userScopes UserScope[]

  @@map("inventory_locations")
}

enum InventoryLotKind {
  /// The supplier's own lot code.
  SUPPLIER
  /// Created by AYVO OS for one receipt line when the supplier gives no lot.
  INTERNAL
}

/// Lot of a lot-tracked item. DB: immutable; SUPPLIER ⇒ supplier + supplier_lot_code,
/// (item, supplier, supplier_lot_code) unique (partial) — two suppliers may use the same lot code;
/// INTERNAL ⇒ (item, code) unique (partial),
/// origin_receipt_line_id (unique, deferrable FK) and no supplier lot code; lot item must be
/// lot-tracked.
model InventoryLot {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  itemId              String           @map("item_id") @db.Uuid
  kind                InventoryLotKind
  /// Display code: the supplier lot code, or "GR-000001/1" for an internal lot.
  code                String
  supplierId          String?          @map("supplier_id") @db.Uuid
  supplierLotCode     String?          @map("supplier_lot_code")
  originReceiptLineId String?          @unique @map("origin_receipt_line_id") @db.Uuid
  expiresOn           DateTime?        @map("expires_on") @db.Date
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  item              InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  originReceiptLine GoodsReceiptLine?   @relation("InternalLotOrigin", fields: [originReceiptLineId], references: [id], onDelete: Restrict)
  receiptLines      GoodsReceiptLine[]  @relation("ReceiptLineLot")
  movements         InventoryMovement[]
  balances          InventoryBalance[]

  @@index([itemId, code])
  @@map("inventory_lots")
}

enum InventoryMovementType {
  RECEIPT
  RECEIPT_CORRECTION
  LABEL_APPLICATION
}

/// The append-only stock ledger: the source of truth for every quantity.
/// DB: UPDATE/DELETE/TRUNCATE rejected; quantity ≠ 0 in the unit's scale; type ⇔ sign ⇔ exactly
/// one source; item/lot/quantity equal to the source (receipt line, correction, BOM line);
/// lot ⇔ item lot-tracked; a BEFORE INSERT trigger updates inventory_balances and sets
/// balance_after (a negative balance aborts the transaction); unique RECEIPT per line, one
/// movement per correction, one per (bottle_event, bom_line).
model InventoryMovement {
  id                  String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  itemId              String                @map("item_id") @db.Uuid
  unitId              String                @map("unit_id") @db.Uuid
  locationId          String                @map("location_id") @db.Uuid
  lotId               String?               @map("lot_id") @db.Uuid
  quantityDelta       Decimal               @map("quantity_delta") @db.Decimal(19, 3)
  type                InventoryMovementType
  receiptLineId       String?               @map("receipt_line_id") @db.Uuid
  receiptCorrectionId String?               @map("receipt_correction_id") @db.Uuid
  bottleEventId       String?               @map("bottle_event_id") @db.Uuid
  bomLineId           String?               @map("bom_line_id") @db.Uuid
  /// On-hand of (item, location, lot) after this movement — always set by the ledger trigger
  /// (the default only lets inserts omit it).
  balanceAfter        Decimal               @default(0) @map("balance_after") @db.Decimal(19, 3)
  occurredAt          DateTime              @map("occurred_at") @db.Timestamptz(3)
  recordedAt          DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(3)
  actorId             String?               @map("actor_id") @db.Uuid
  requestId           String?               @map("request_id") @db.Uuid

  item              InventoryItem           @relation(fields: [itemId, unitId], references: [id, baseUnitId], onDelete: Restrict)
  location          InventoryLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lot               InventoryLot?           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  receiptLine       GoodsReceiptLine?       @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  receiptCorrection GoodsReceiptCorrection? @relation(fields: [receiptCorrectionId], references: [id], onDelete: Restrict)
  bottleEvent       BottleEvent?            @relation(fields: [bottleEventId], references: [id], onDelete: Restrict)
  bomLine           BomLine?                @relation(fields: [bomLineId], references: [id], onDelete: Restrict)

  @@index([itemId, locationId, lotId, recordedAt])
  @@index([lotId])
  @@index([bottleEventId])
  @@index([receiptLineId])
  @@index([receiptCorrectionId])
  @@map("inventory_movements")
}

/// Current on-hand per (item, location, lot): a cache of Σ ledger.
/// DB: written only by the ledger trigger; CHECK on_hand >= 0; unique per (item, location, lot)
/// via two partial unique indexes (lot NULL / NOT NULL).
model InventoryBalance {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  lotId      String?  @map("lot_id") @db.Uuid
  onHand     Decimal  @map("on_hand") @db.Decimal(19, 3)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lot      InventoryLot?     @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([itemId, locationId])
  @@index([lotId])
  @@map("inventory_balances")
}

enum ConsumptionStage {
  LABEL_APPLICATION
}

/// A versioned consumption rule (BOM). Now: stage rules; later also product recipes.
/// DB: immutable; version >= 1; (code, version) unique.
model BomVersion {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String
  version   Int
  stage     ConsumptionStage
  validFrom DateTime         @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime?        @map("valid_to") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  lines BomLine[]

  @@unique([code, version])
  @@map("bom_versions")
}

/// One component of a BOM version: exact quantity in the item's base unit.
/// DB: immutable; quantity > 0 in the unit's scale; (bom_version_id, line_no) unique.
model BomLine {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bomVersionId String  @map("bom_version_id") @db.Uuid
  lineNo       Int     @map("line_no")
  itemId       String  @map("item_id") @db.Uuid
  unitId       String  @map("unit_id") @db.Uuid
  quantity     Decimal @db.Decimal(19, 3)

  bomVersion BomVersion          @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  item       InventoryItem       @relation(fields: [itemId, unitId], references: [id, baseUnitId], onDelete: Restrict)
  movements  InventoryMovement[]

  @@unique([bomVersionId, lineNo])
  @@map("bom_lines")
}

// ---------------------------------------------------------------------------------------------
// procurement module — suppliers, supplier documents, goods receipts (doc 018)
// ---------------------------------------------------------------------------------------------

/// DB: name unique (case-insensitive index); immutable except a one-way archive; DELETE rejected.
model Supplier {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  companyId  String?   @map("company_id")
  vatId      String?   @map("vat_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  requestId  String    @unique @map("request_id") @db.Uuid

  documents        SupplierDocument[]
  receipts         GoodsReceipt[]
  lots             InventoryLot[]
  preferredForItem InventoryItemSetting[]

  @@map("suppliers")
}

enum SupplierDocumentKind {
  INVOICE
  DELIVERY_NOTE
  OTHER_APPROVED
}

/// An uploaded supplier document (file in FileStorage, never a path to clients).
/// DB: immutable; DELETE rejected; byte_size > 0; sha256 hex; storage_key unique.
model SupplierDocument {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  supplierId       String               @map("supplier_id") @db.Uuid
  kind             SupplierDocumentKind
  documentNumber   String               @map("document_number")
  issuedOn         DateTime             @map("issued_on") @db.Date
  storageKey       String               @unique @map("storage_key")
  sha256           String               @db.Char(64)
  byteSize         Int                  @map("byte_size")
  contentType      String               @map("content_type")
  originalFilename String               @map("original_filename")
  /// A correction is a new document superseding the old one; nothing is overwritten.
  supersedesId     String?              @map("supersedes_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId          String?              @map("actor_id") @db.Uuid
  requestId        String               @unique @map("request_id") @db.Uuid

  supplier     Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supersedes   SupplierDocument?      @relation("SupplierDocumentSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy SupplierDocument[]     @relation("SupplierDocumentSupersedes")
  receiptLinks GoodsReceiptDocument[]

  @@index([supplierId])
  @@map("supplier_documents")
}

enum GoodsReceiptType {
  PURCHASE
}

/// A confirmed physical receipt of goods ("GR-000001"). Created confirmed; immutable.
/// DB: code derived from serial; immutable; DELETE rejected; a PURCHASE receipt has at least
/// one INVOICE or DELIVERY_NOTE link at commit (deferred trigger); every line has its RECEIPT
/// movement at commit (deferred trigger).
model GoodsReceipt {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial            BigInt           @unique
  code              String           @unique
  type              GoodsReceiptType
  supplierId        String           @map("supplier_id") @db.Uuid
  /// Supplier delivery-note or invoice number as printed on the paperwork.
  supplierReference String           @map("supplier_reference")
  receivedAt        DateTime         @map("received_at") @db.Timestamptz(3)
  note              String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId           String?          @map("actor_id") @db.Uuid
  requestId         String           @unique @map("request_id") @db.Uuid

  supplier  Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines     GoodsReceiptLine[]
  documents GoodsReceiptDocument[]

  @@index([supplierId])
  @@map("goods_receipts")
}

/// DB: immutable; quantity > 0 in the unit's scale; lot ⇔ item lot-tracked, lot of the same item
/// (and same supplier for SUPPLIER lots); price and currency both or neither; (receipt, line_no)
/// unique.
model GoodsReceiptLine {
  id        String   @id @db.Uuid
  receiptId String   @map("receipt_id") @db.Uuid
  lineNo    Int      @map("line_no")
  itemId    String   @map("item_id") @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  quantity  Decimal  @db.Decimal(19, 3)
  lotId     String?  @map("lot_id") @db.Uuid
  unitPrice Decimal? @map("unit_price") @db.Decimal(19, 4)
  currency  String?  @db.Char(3)
  vatRate   Decimal? @map("vat_rate") @db.Decimal(5, 2)

  receipt     GoodsReceipt             @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  item        InventoryItem            @relation(fields: [itemId, unitId], references: [id, baseUnitId], onDelete: Restrict)
  lot         InventoryLot?            @relation("ReceiptLineLot", fields: [lotId], references: [id], onDelete: Restrict)
  internalLot InventoryLot?            @relation("InternalLotOrigin")
  corrections GoodsReceiptCorrection[]
  movements   InventoryMovement[]

  @@unique([receiptId, lineNo])
  @@index([lotId])
  @@map("goods_receipt_lines")
}

/// Append-only link of a receipt to a supplier document (documents can be added, never removed).
/// DB: insert-only; document of the receipt's supplier.
model GoodsReceiptDocument {
  receiptId  String   @map("receipt_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  requestId  String   @map("request_id") @db.Uuid

  receipt  GoodsReceipt     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  document SupplierDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([receiptId, documentId])
  @@index([documentId])
  @@map("goods_receipt_documents")
}

/// Compensating correction of a receipt line. DB: immutable; quantity ≠ 0 in the unit's scale;
/// reason required; line quantity + Σ corrections >= 0 (line row locked); its movement exists at
/// commit (deferred trigger).
model GoodsReceiptCorrection {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  receiptLineId String   @map("receipt_line_id") @db.Uuid
  quantityDelta Decimal  @map("quantity_delta") @db.Decimal(19, 3)
  reason        String
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId       String?  @map("actor_id") @db.Uuid
  requestId     String   @unique @map("request_id") @db.Uuid

  receiptLine GoodsReceiptLine    @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  movements   InventoryMovement[]

  @@index([receiptLineId])
  @@map("goods_receipt_corrections")
}

// ---------------------------------------------------------------------------------------------
// Shared: idempotency of mutating operations (doc 018 §8)
// ---------------------------------------------------------------------------------------------

enum OperationKind {
  SUPPLIER_CREATE
  SUPPLIER_ARCHIVE
  SUPPLIER_DOCUMENT_UPLOAD
  GOODS_RECEIPT
  RECEIPT_DOCUMENT_LINK
  RECEIPT_CORRECTION
  ITEM_SETTINGS
  LABEL_APPLICATION
}

/// One row per successful mutating request. Same request id + same payload → stored result;
/// different payload → conflict. DB: insert-only except setting `result` once (NULL → value).
model OperationRequest {
  requestId     String        @id @map("request_id") @db.Uuid
  kind          OperationKind
  payloadSha256 String        @map("payload_sha256") @db.Char(64)
  result        Json?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("operation_requests")
}

// ---------------------------------------------------------------------------------------------
// identity module — users, external identities, roles, permissions, scopes, sessions, audit
// (Milestone 2C, ADR 0022, doc 021). Authentication is delegated to an external OIDC provider;
// authorization is evaluated from these tables on every request.
// ---------------------------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

/// An AYVO user. Never deleted; deactivation revokes access immediately.
/// DB: email lower-case and unique; deactivation fields all-or-none; DELETE rejected.
model User {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email              String     @unique
  displayName        String     @map("display_name")
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// NULL only for the bootstrap administrator.
  createdBy          String?    @map("created_by") @db.Uuid
  deactivatedAt      DateTime?  @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy      String?    @map("deactivated_by") @db.Uuid
  deactivationReason String?    @map("deactivation_reason")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)

  createdByUser     User?              @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdUsers      User[]             @relation("UserCreatedBy")
  deactivatedByUser User?              @relation("UserDeactivatedBy", fields: [deactivatedBy], references: [id], onDelete: Restrict)
  deactivatedUsers  User[]             @relation("UserDeactivatedBy")
  identities        UserIdentity[]
  roles             UserRole[]         @relation("UserRoles")
  rolesGranted      UserRole[]         @relation("RoleGrantedBy")
  rolesRevoked      UserRole[]         @relation("RoleRevokedBy")
  scopes            UserScope[]        @relation("UserScopes")
  scopesGranted     UserScope[]        @relation("ScopeGrantedBy")
  scopesRevoked     UserScope[]        @relation("ScopeRevokedBy")
  sessions          UserSession[]
  bootstrap         IdentityBootstrap?

  @@map("users")
}

/// Link of an external identity (provider + subject) to an AYVO user.
/// DB: one active link per (provider, subject) and per (user, provider) (partial unique);
/// provider/subject/user immutable; unlink closes once; DELETE rejected.
model UserIdentity {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// "WORKOS" (production/DEV) or "TEST" (APP_ENV=test only).
  provider    String
  subject     String
  emailAtLink String    @map("email_at_link")
  linkedAt    DateTime  @default(now()) @map("linked_at") @db.Timestamptz(3)
  unlinkedAt  DateTime? @map("unlinked_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions UserSession[]

  @@index([userId])
  @@map("user_identities")
}

/// Role catalogue. DB: seeded by migration; changes only by migration.
model Role {
  code        String @id
  name        String
  description String

  permissions RolePermission[]
  grants      UserRole[]

  @@map("roles")
}

/// Permission catalogue. DB: seeded by migration; changes only by migration.
model Permission {
  code            String  @id
  description     String
  /// Also requires a warehouse scope for the warehouse the request acts on.
  warehouseScoped Boolean @map("warehouse_scoped")

  roles RolePermission[]

  @@map("permissions")
}

/// Which permissions a role grants. DB: seeded by migration.
model RolePermission {
  roleCode       String @map("role_code")
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

/// A role granted to a user. Revocation closes the grant once; the grant row stays as history.
/// DB: at most one open grant per (user, role) (partial unique); DELETE rejected.
model UserRole {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleCode     String    @map("role_code")
  grantedAt    DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedBy    String?   @map("granted_by") @db.Uuid
  grantReason  String    @map("grant_reason")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user          User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role          Role  @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  grantedByUser User? @relation("RoleGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("RoleRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_roles")
}

enum ScopeType {
  WAREHOUSE
  HOTEL_ORGANIZATION
  HOTEL_SITE
}

/// Data access scope of a user. WAREHOUSE references an inventory location; hotel scopes
/// reference hotel organizations/sites once those modules exist (no FK yet).
/// DB: WAREHOUSE ⇔ location_id set; hotel scopes ⇔ scope_ref set; at most one open scope per
/// target (partial unique); revocation closes once; DELETE rejected.
model UserScope {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       ScopeType
  locationId String?   @map("location_id") @db.Uuid
  scopeRef   String?   @map("scope_ref") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedBy  String?   @map("granted_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy  String?   @map("revoked_by") @db.Uuid

  user          User               @relation("UserScopes", fields: [userId], references: [id], onDelete: Restrict)
  location      InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  grantedByUser User?              @relation("ScopeGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  revokedByUser User?              @relation("ScopeRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_scopes")
}

/// An AYVO application session. Only the SHA-256 of the random cookie token is stored.
/// DB: token hash unique; revocation closes once.
model UserSession {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenSha256       String    @unique @map("token_sha256") @db.Char(64)
  userId            String    @map("user_id") @db.Uuid
  identityId        String    @map("identity_id") @db.Uuid
  /// The provider's session id (for provider logout); never a credential.
  providerSessionId String?   @map("provider_session_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason")

  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  identity UserIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_sessions")
}

/// One-time OAuth state of a login attempt (CSRF protection of the callback, PKCE verifier).
/// DB: state hash unique; used once.
model AuthLoginState {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stateSha256   String    @unique @map("state_sha256") @db.Char(64)
  /// SHA-256 of the browser-binding cookie set when the attempt started.
  bindingSha256 String    @map("binding_sha256") @db.Char(64)
  codeVerifier  String    @map("code_verifier")
  nextPath      String    @map("next_path")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)

  @@map("auth_login_states")
}

/// The one-time bootstrap of the first administrator. DB: a single row ever (PK = true);
/// insert-only.
model IdentityBootstrap {
  singleton Boolean  @id @default(true)
  userId    String   @unique @map("user_id") @db.Uuid
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("identity_bootstrap")
}

/// Append-only security and administration audit (logins, role and scope changes, …).
/// DB: UPDATE/DELETE rejected.
model AuditEvent {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         String
  /// NULL for system actions (bootstrap) and anonymous login attempts.
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  reason       String?
  payload      Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([targetUserId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}
