{
  "name": "@ayvo/api",
  "version": "0.0.0",
  "private": true,
  "description": "AYVO OS backend — NestJS modular monolith",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "identity:bootstrap-admin": "node dist/identity/bootstrap-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@ayvo/types": "workspace:*",
    "@napi-rs/canvas": "1.0.10",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@smithy/node-http-handler": "4.12.1",
    "ioredis": "^6.0.0",
    "jose": "6.2.12",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svg-to-pdfkit": "0.1.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ayvo/config": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.4.299",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
