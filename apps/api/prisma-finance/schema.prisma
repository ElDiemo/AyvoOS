// AYVO Finance — its own runtime unit (ADR 0039): schema "finance" only, its own migration
// history (finance._prisma_migrations), no foreign keys to the core ("public"). Suppliers,
// supplier documents, sites and users are plain ids plus the snapshot Finance needs; their
// current state comes from the core contract (/api/internal/v1/finance/*), never from its tables.
// Invariants Prisma cannot express are raw SQL in the migrations ("DB:").

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/finance-prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["finance"]
}

/// Gapless code counters of Finance (FD-…, AE-…).
model CodeCounter {
  name      String @id
  lastValue BigInt @default(0) @map("last_value")

  @@map("code_counters")
  @@schema("finance")
}

/// Idempotency of Finance writes per client request id (the core pattern, in Finance's schema).
model OperationRequest {
  requestId     String   @id @map("request_id") @db.Uuid
  kind          String
  payloadSha256 String   @map("payload_sha256") @db.Char(64)
  result        Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("operation_requests")
  @@schema("finance")
}

/// A received document (doc 039, N1): Finance's own PDF (UPLOAD) or a reference to a supplier
/// document of Sklad (SUPPLIER_DOCUMENT, no copy). Metadata may be incomplete ("k doplnění").
/// DB: file/source/identity immutable; changes only with the next version and its event; voided
/// = frozen; never deleted; one active record per file and per supplier document.
model Document {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial             BigInt    @unique
  code               String    @unique
  /// Core supplier id + its name as of the current version.
  supplierId         String?   @map("supplier_id") @db.Uuid
  supplierName       String?   @map("supplier_name")
  kind               String
  documentNumber     String?   @map("document_number")
  issuedOn           DateTime? @map("issued_on") @db.Date
  taxPointOn         DateTime? @map("tax_point_on") @db.Date
  dueOn              DateTime? @map("due_on") @db.Date
  totalAmount        Decimal?  @map("total_amount") @db.Decimal(19, 2)
  currency           String?   @db.Char(3)
  description        String?
  /// First day of the month whose export the document belongs to (organisational, not a tax date).
  handoverMonth      DateTime? @map("handover_month") @db.Date
  status             String    @default("ACTIVE")
  version            Int       @default(1)
  source             String
  /// Core supplier document id and its site (code as of the takeover).
  supplierDocumentId String?   @map("supplier_document_id") @db.Uuid
  sourceSiteId       String?   @map("source_site_id") @db.Uuid
  sourceSiteCode     String?   @map("source_site_code")
  storageKey         String?   @unique @map("storage_key")
  sha256             String    @db.Char(64)
  byteSize           Int       @map("byte_size")
  contentType        String    @map("content_type")
  originalFilename   String    @map("original_filename")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Core user id + display name as of the creation.
  createdBy          String    @map("created_by") @db.Uuid
  createdByName      String    @map("created_by_name")
  requestId          String    @unique @map("request_id") @db.Uuid
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  events      DocumentEvent[]
  exportItems ExportItem[]

  @@index([issuedOn])
  @@index([supplierId])
  @@index([handoverMonth])
  @@index([supplierDocumentId])
  @@map("documents")
  @@schema("finance")
}

/// Append-only history of a document: RECEIVED, CORRECTED (full snapshot, reason), VOIDED.
model DocumentEvent {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  version    Int
  type       String
  snapshot   Json
  reason     String?
  actorId    String   @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  document    Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  exportItems ExportItem[]

  @@unique([documentId, version])
  @@map("document_events")
  @@schema("finance")
}

/// An export for the accountant (doc 039 §7, N2): one handover month, a fixed ZIP (CSV manifest +
/// originals), bound to the confirmed preview. DB: append-only; has its GENERATED event.
model Export {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial             BigInt   @unique
  code               String   @unique
  handoverMonth      DateTime @map("handover_month") @db.Date
  mode               String
  note               String?
  previewFingerprint String   @map("preview_fingerprint") @db.Char(64)
  documentCount      Int      @map("document_count")
  storageKey         String   @unique @map("storage_key")
  sha256             String   @db.Char(64)
  byteSize           Int      @map("byte_size")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String   @map("created_by") @db.Uuid
  createdByName      String   @map("created_by_name")
  requestId          String   @unique @map("request_id") @db.Uuid

  items  ExportItem[]
  events ExportEvent[]

  @@index([handoverMonth])
  @@map("exports")
  @@schema("finance")
}

/// One document version in an export, with its change and file hash. DB: append-only.
model ExportItem {
  exportId        String @map("export_id") @db.Uuid
  documentId      String @map("document_id") @db.Uuid
  documentVersion Int    @map("document_version")
  change          String
  sha256          String @db.Char(64)

  export   Export        @relation(fields: [exportId], references: [id], onDelete: Restrict)
  document Document      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  event    DocumentEvent @relation(fields: [documentId, documentVersion], references: [documentId, version], onDelete: Restrict)

  @@id([exportId, documentId])
  @@index([documentId, documentVersion])
  @@map("export_items")
  @@schema("finance")
}

/// GENERATED, DOWNLOADED, HANDED_OVER (once, with the day and a note). DB: append-only.
model ExportEvent {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  exportId     String    @map("export_id") @db.Uuid
  type         String
  handedOverOn DateTime? @map("handed_over_on") @db.Date
  note         String?
  actorId      String    @map("actor_id") @db.Uuid
  actorName    String    @map("actor_name")
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  export Export @relation(fields: [exportId], references: [id], onDelete: Restrict)

  @@index([exportId])
  @@map("export_events")
  @@schema("finance")
}

/// The billed company of hotel billing (doc 040, N3A-1) — not the hotel (a company may run several).
/// Its details are versions; the newest is current. DB: append-only.
model Customer {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial        BigInt   @unique
  code          String   @unique
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String   @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  requestId     String   @unique @map("request_id") @db.Uuid

  versions          CustomerVersion[]
  agreementVersions AgreementVersion[]

  @@map("customers")
  @@schema("finance")
}

/// One version of a customer's details (version 1 = creation; later ones carry a reason).
model CustomerVersion {
  customerId     String   @map("customer_id") @db.Uuid
  version        Int
  legalName      String   @map("legal_name")
  companyId      String?  @map("company_id")
  vatId          String?  @map("vat_id")
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  postalCode     String   @map("postal_code")
  city           String
  countryCode    String   @map("country_code") @db.Char(2)
  billingEmail   String   @map("billing_email")
  reason         String?
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String   @map("recorded_by") @db.Uuid
  recordedByName String   @map("recorded_by_name")
  requestId      String   @unique @map("request_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@id([customerId, version])
  @@map("customer_versions")
  @@schema("finance")
}

/// The default price per room and month of a currency, effective from the first day of a month.
/// A correction is a new row with the same effective_from (the newest recorded wins). DB: append-only.
model PriceListVersion {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// From the counter billing_revision: commit order, never tied (the newest is the later correction).
  revision          BigInt   @unique
  currency          String   @db.Char(3)
  pricePerRoomMonth Decimal  @map("price_per_room_month") @db.Decimal(19, 2)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  reason            String
  recordedAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy        String   @map("recorded_by") @db.Uuid
  recordedByName    String   @map("recorded_by_name")
  requestId         String   @unique @map("request_id") @db.Uuid

  @@index([currency, effectiveFrom, revision], map: "price_list_versions_lookup_idx")
  @@map("price_list_versions")
  @@schema("finance")
}

/// One billing agreement per hotel (core hotel id + code/name as of the creation). DB: append-only.
model BillingAgreement {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial        BigInt   @unique
  code          String   @unique
  hotelId       String   @unique @map("hotel_id") @db.Uuid
  hotelCode     String   @map("hotel_code")
  hotelName     String   @map("hotel_name")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String   @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  requestId     String   @unique @map("request_id") @db.Uuid

  versions AgreementVersion[]

  @@map("billing_agreements")
  @@schema("finance")
}

/// The terms of an agreement from a month on (bitemporal: effective_from + recorded_at). The only
/// place of billed rooms and the hotel's own price. DB: append-only.
model AgreementVersion {
  id                   String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// From the counter billing_revision: commit order, never tied (the newest is the later correction).
  revision             BigInt    @unique
  agreementId          String    @map("agreement_id") @db.Uuid
  effectiveFrom        DateTime  @map("effective_from") @db.Date
  customerId           String    @map("customer_id") @db.Uuid
  contractNumber       String?   @map("contract_number")
  billedRooms          Int       @map("billed_rooms")
  /// NULL = the default price list of the currency; 0.00 is an explicit price.
  ownPricePerRoomMonth Decimal?  @map("own_price_per_room_month") @db.Decimal(19, 2)
  currency             String    @db.Char(3)
  paymentTermsDays     Int       @map("payment_terms_days")
  billingTiming        String    @map("billing_timing")
  validFrom            DateTime  @map("valid_from") @db.Date
  validTo              DateTime? @map("valid_to") @db.Date
  reason               String
  recordedAt           DateTime  @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy           String    @map("recorded_by") @db.Uuid
  recordedByName       String    @map("recorded_by_name")
  requestId            String    @unique @map("request_id") @db.Uuid

  agreement BillingAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([agreementId, effectiveFrom, revision], map: "agreement_versions_lookup_idx")
  @@index([customerId], map: "agreement_versions_customer_idx")
  @@map("agreement_versions")
  @@schema("finance")
}
