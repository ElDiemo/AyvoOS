// AYVO Finance — its own runtime unit (ADR 0039): schema "finance" only, its own migration
// history (finance._prisma_migrations), no foreign keys to the core ("public"). Suppliers,
// supplier documents, sites and users are plain ids plus the snapshot Finance needs; their
// current state comes from the core contract (/api/internal/v1/finance/*), never from its tables.
// Invariants Prisma cannot express are raw SQL in the migrations ("DB:").

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/finance-prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["finance"]
}

/// Gapless code counters of Finance (FD-…, AE-…).
model CodeCounter {
  name      String @id
  lastValue BigInt @default(0) @map("last_value")

  @@map("code_counters")
  @@schema("finance")
}

/// Idempotency of Finance writes per client request id (the core pattern, in Finance's schema).
model OperationRequest {
  requestId     String   @id @map("request_id") @db.Uuid
  kind          String
  payloadSha256 String   @map("payload_sha256") @db.Char(64)
  result        Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("operation_requests")
  @@schema("finance")
}

/// A received document (doc 039, N1): Finance's own PDF (UPLOAD) or a reference to a supplier
/// document of Sklad (SUPPLIER_DOCUMENT, no copy). Metadata may be incomplete ("k doplnění").
/// DB: file/source/identity immutable; changes only with the next version and its event; voided
/// = frozen; never deleted; one active record per file and per supplier document.
model Document {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial             BigInt    @unique
  code               String    @unique
  /// Core supplier id + its name as of the current version.
  supplierId         String?   @map("supplier_id") @db.Uuid
  supplierName       String?   @map("supplier_name")
  kind               String
  documentNumber     String?   @map("document_number")
  issuedOn           DateTime? @map("issued_on") @db.Date
  taxPointOn         DateTime? @map("tax_point_on") @db.Date
  dueOn              DateTime? @map("due_on") @db.Date
  totalAmount        Decimal?  @map("total_amount") @db.Decimal(19, 2)
  currency           String?   @db.Char(3)
  description        String?
  /// First day of the month whose export the document belongs to (organisational, not a tax date).
  handoverMonth      DateTime? @map("handover_month") @db.Date
  status             String    @default("ACTIVE")
  version            Int       @default(1)
  source             String
  /// Core supplier document id and its site (code as of the takeover).
  supplierDocumentId String?   @map("supplier_document_id") @db.Uuid
  sourceSiteId       String?   @map("source_site_id") @db.Uuid
  sourceSiteCode     String?   @map("source_site_code")
  storageKey         String?   @unique @map("storage_key")
  sha256             String    @db.Char(64)
  byteSize           Int       @map("byte_size")
  contentType        String    @map("content_type")
  originalFilename   String    @map("original_filename")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Core user id + display name as of the creation.
  createdBy          String    @map("created_by") @db.Uuid
  createdByName      String    @map("created_by_name")
  requestId          String    @unique @map("request_id") @db.Uuid
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  events      DocumentEvent[]
  exportItems ExportItem[]

  @@index([issuedOn])
  @@index([supplierId])
  @@index([handoverMonth])
  @@index([supplierDocumentId])
  @@map("documents")
  @@schema("finance")
}

/// Append-only history of a document: RECEIVED, CORRECTED (full snapshot, reason), VOIDED.
model DocumentEvent {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  version    Int
  type       String
  snapshot   Json
  reason     String?
  actorId    String   @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  document    Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  exportItems ExportItem[]

  @@unique([documentId, version])
  @@map("document_events")
  @@schema("finance")
}

/// An export for the accountant (doc 039 §7, N2): one handover month, a fixed ZIP (CSV manifest +
/// originals), bound to the confirmed preview. DB: append-only; has its GENERATED event.
model Export {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial             BigInt   @unique
  code               String   @unique
  handoverMonth      DateTime @map("handover_month") @db.Date
  mode               String
  note               String?
  previewFingerprint String   @map("preview_fingerprint") @db.Char(64)
  documentCount      Int      @map("document_count")
  storageKey         String   @unique @map("storage_key")
  sha256             String   @db.Char(64)
  byteSize           Int      @map("byte_size")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String   @map("created_by") @db.Uuid
  createdByName      String   @map("created_by_name")
  requestId          String   @unique @map("request_id") @db.Uuid

  items  ExportItem[]
  events ExportEvent[]

  @@index([handoverMonth])
  @@map("exports")
  @@schema("finance")
}

/// One document version in an export, with its change and file hash. DB: append-only.
model ExportItem {
  exportId        String @map("export_id") @db.Uuid
  documentId      String @map("document_id") @db.Uuid
  documentVersion Int    @map("document_version")
  change          String
  sha256          String @db.Char(64)

  export   Export        @relation(fields: [exportId], references: [id], onDelete: Restrict)
  document Document      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  event    DocumentEvent @relation(fields: [documentId, documentVersion], references: [documentId, version], onDelete: Restrict)

  @@id([exportId, documentId])
  @@index([documentId, documentVersion])
  @@map("export_items")
  @@schema("finance")
}

/// GENERATED, DOWNLOADED, HANDED_OVER (once, with the day and a note). DB: append-only.
model ExportEvent {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  exportId     String    @map("export_id") @db.Uuid
  type         String
  handedOverOn DateTime? @map("handed_over_on") @db.Date
  note         String?
  actorId      String    @map("actor_id") @db.Uuid
  actorName    String    @map("actor_name")
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  export Export @relation(fields: [exportId], references: [id], onDelete: Restrict)

  @@index([exportId])
  @@map("export_events")
  @@schema("finance")
}

/// The billed company of hotel billing (doc 040, N3A-1) — not the hotel (a company may run several).
/// Its details are versions; the newest is current. DB: append-only.
model Customer {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial        BigInt   @unique
  code          String   @unique
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String   @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  requestId     String   @unique @map("request_id") @db.Uuid

  versions          CustomerVersion[]
  agreementVersions AgreementVersion[]

  @@map("customers")
  @@schema("finance")
}

/// One version of a customer's details (version 1 = creation; later ones carry a reason).
model CustomerVersion {
  customerId     String   @map("customer_id") @db.Uuid
  version        Int
  legalName      String   @map("legal_name")
  companyId      String?  @map("company_id")
  vatId          String?  @map("vat_id")
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  postalCode     String   @map("postal_code")
  city           String
  countryCode    String   @map("country_code") @db.Char(2)
  billingEmail   String   @map("billing_email")
  reason         String?
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String   @map("recorded_by") @db.Uuid
  recordedByName String   @map("recorded_by_name")
  requestId      String   @unique @map("request_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  invoices Invoice[]

  @@id([customerId, version])
  @@map("customer_versions")
  @@schema("finance")
}

/// The default price per room and month of a currency, effective from the first day of a month.
/// A correction is a new row with the same effective_from (the newest recorded wins). DB: append-only.
model PriceListVersion {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// From the counter billing_revision: commit order, never tied (the newest is the later correction).
  revision          BigInt   @unique
  currency          String   @db.Char(3)
  pricePerRoomMonth Decimal  @map("price_per_room_month") @db.Decimal(19, 2)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  reason            String
  recordedAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy        String   @map("recorded_by") @db.Uuid
  recordedByName    String   @map("recorded_by_name")
  requestId         String   @unique @map("request_id") @db.Uuid

  @@index([currency, effectiveFrom, revision], map: "price_list_versions_lookup_idx")
  @@map("price_list_versions")
  @@schema("finance")
}

/// One billing agreement per hotel (core hotel id + code/name as of the creation). DB: append-only.
model BillingAgreement {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial        BigInt   @unique
  code          String   @unique
  hotelId       String   @unique @map("hotel_id") @db.Uuid
  hotelCode     String   @map("hotel_code")
  hotelName     String   @map("hotel_name")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String   @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  requestId     String   @unique @map("request_id") @db.Uuid

  versions     AgreementVersion[]
  invoiceLines InvoiceLine[]

  @@map("billing_agreements")
  @@schema("finance")
}

/// The terms of an agreement from a month on (bitemporal: effective_from + recorded_at). The only
/// place of billed rooms and the hotel's own price. DB: append-only.
model AgreementVersion {
  id                   String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// From the counter billing_revision: commit order, never tied (the newest is the later correction).
  revision             BigInt    @unique
  agreementId          String    @map("agreement_id") @db.Uuid
  effectiveFrom        DateTime  @map("effective_from") @db.Date
  customerId           String    @map("customer_id") @db.Uuid
  contractNumber       String?   @map("contract_number")
  billedRooms          Int       @map("billed_rooms")
  /// NULL = the default price list of the currency; 0.00 is an explicit price.
  ownPricePerRoomMonth Decimal?  @map("own_price_per_room_month") @db.Decimal(19, 2)
  currency             String    @db.Char(3)
  paymentTermsDays     Int       @map("payment_terms_days")
  billingTiming        String    @map("billing_timing")
  validFrom            DateTime  @map("valid_from") @db.Date
  validTo              DateTime? @map("valid_to") @db.Date
  reason               String
  recordedAt           DateTime  @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy           String    @map("recorded_by") @db.Uuid
  recordedByName       String    @map("recorded_by_name")
  requestId            String    @unique @map("request_id") @db.Uuid

  agreement BillingAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  invoiceLines InvoiceLine[]

  @@index([agreementId, effectiveFrom, revision], map: "agreement_versions_lookup_idx")
  @@index([customerId], map: "agreement_versions_customer_idx")
  @@map("agreement_versions")
  @@schema("finance")
}

/// Our company as the issuer of invoices, in versions (N3A-2a, doc 040 §8). DB: append-only.
model IssuerVersion {
  version        Int      @id
  legalName      String   @map("legal_name")
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  postalCode     String   @map("postal_code")
  city           String
  countryCode    String   @map("country_code") @db.Char(2)
  companyId      String   @map("company_id")
  vatStatus      String   @map("vat_status")
  vatId          String?  @map("vat_id")
  registration   String?
  email          String
  phone          String?
  web            String?
  reason         String
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String   @map("recorded_by") @db.Uuid
  recordedByName String   @map("recorded_by_name")
  requestId      String   @unique @map("request_id") @db.Uuid

  @@map("issuer_versions")
  @@schema("finance")
}

/// A bank account printed on invoices (not the bank connection). DB: append-only, never deleted.
model IssuerBankAccount {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial        BigInt   @unique
  code          String   @unique
  createdAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  createdBy     String   @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  requestId     String   @unique @map("request_id") @db.Uuid

  versions IssuerBankAccountVersion[]
  defaults IssuerDefaultAccount[]

  @@map("issuer_bank_accounts")
  @@schema("finance")
}

/// The details of an invoice bank account in versions (ACTIVE / RETIRED). DB: append-only.
model IssuerBankAccountVersion {
  accountId      String   @map("account_id") @db.Uuid
  version        Int
  status         String
  label          String
  currency       String   @db.Char(3)
  accountPrefix  String?  @map("account_prefix")
  accountNumber  String?  @map("account_number")
  bankCode       String?  @map("bank_code")
  iban           String
  bic            String?
  reason         String
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String   @map("recorded_by") @db.Uuid
  recordedByName String   @map("recorded_by_name")
  requestId      String   @unique @map("request_id") @db.Uuid

  account IssuerBankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, version])
  @@map("issuer_bank_account_versions")
  @@schema("finance")
}

/// The default invoice account of a currency, chosen in revisions (newest current). DB: append-only.
model IssuerDefaultAccount {
  revision       BigInt   @id
  currency       String   @db.Char(3)
  accountId      String   @map("account_id") @db.Uuid
  reason         String
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String   @map("recorded_by") @db.Uuid
  recordedByName String   @map("recorded_by_name")
  requestId      String   @unique @map("request_id") @db.Uuid

  account IssuerBankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([currency, revision], map: "issuer_default_accounts_currency_idx")
  @@map("issuer_default_accounts")
  @@schema("finance")
}

/// One read of one account × currency from the bank (N3B-1, doc 041). DB: RUNNING → finished
/// exactly once (trigger); never deleted.
model BankSyncRun {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider      String
  environment   String
  accountNumber String    @map("account_number")
  currency      String    @db.Char(3)
  fromDate      DateTime  @map("from_date") @db.Date
  toDate        DateTime  @map("to_date") @db.Date
  status        String    @default("RUNNING")
  startedAt     DateTime  @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz(3)
  startedBy     String    @map("started_by") @db.Uuid
  startedByName String    @map("started_by_name")
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  pages         Int?
  received      Int?
  newCount      Int?      @map("new_count")
  changedCount  Int?      @map("changed_count")
  errorCode     String?   @map("error_code")
  errorDetail   String?   @map("error_detail")

  slots        BankSyncSlot[]
  transactions BankTransaction[]
  versions     BankTransactionVersion[]

  @@index([environment, accountNumber, currency, startedAt], map: "bank_sync_runs_account_idx")
  @@map("bank_sync_runs")
  @@schema("finance")
}

/// Which run currently reads an account × currency (no overlapping runs). DB: never deleted.
model BankSyncSlot {
  environment   String
  accountNumber String    @map("account_number")
  currency      String    @db.Char(3)
  runningRunId  String?   @map("running_run_id") @db.Uuid
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)

  runningRun BankSyncRun? @relation(fields: [runningRunId], references: [id], onDelete: Restrict)

  @@id([environment, accountNumber, currency])
  @@map("bank_sync_slots")
  @@schema("finance")
}

/// A bank entry, once per (environment, account, currency, entryReference). DB: append-only.
model BankTransaction {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  environment    String
  accountNumber  String   @map("account_number")
  currency       String   @db.Char(3)
  entryReference String   @map("entry_reference")
  firstRunId     String   @map("first_run_id") @db.Uuid
  firstSeenAt    DateTime @default(dbgenerated("clock_timestamp()")) @map("first_seen_at") @db.Timestamptz(3)

  firstRun BankSyncRun              @relation(fields: [firstRunId], references: [id], onDelete: Restrict)
  versions BankTransactionVersion[]

  payments IncomingPayment[]

  @@unique([environment, accountNumber, currency, entryReference])
  @@map("bank_transactions")
  @@schema("finance")
}

/// The content of a bank entry as the bank sent it; a different later answer is a new version.
/// DB: append-only.
model BankTransactionVersion {
  transactionId             String    @map("transaction_id") @db.Uuid
  version                   Int
  runId                     String    @map("run_id") @db.Uuid
  recordedAt                DateTime  @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  contentSha256             String    @map("content_sha256") @db.Char(64)
  amount                    Decimal   @db.Decimal(19, 2)
  amountCurrency            String    @map("amount_currency") @db.Char(3)
  creditDebit               String    @map("credit_debit")
  bookingDate               DateTime? @map("booking_date") @db.Timestamptz(3)
  valueDate                 DateTime? @map("value_date") @db.Timestamptz(3)
  bankTransactionCode       String    @map("bank_transaction_code")
  endToEndId                String?   @map("end_to_end_id")
  counterpartyName          String?   @map("counterparty_name")
  counterpartyAccountPrefix String?   @map("counterparty_account_prefix")
  counterpartyAccountNumber String?   @map("counterparty_account_number")
  counterpartyBankCode      String?   @map("counterparty_bank_code")
  counterpartyIban          String?   @map("counterparty_iban")
  variableSymbol            String?   @map("variable_symbol")
  constantSymbol            String?   @map("constant_symbol")
  specificSymbol            String?   @map("specific_symbol")
  message                   String?
  originatorMessage         String?   @map("originator_message")
  instructedAmount          Decimal?  @map("instructed_amount") @db.Decimal(19, 2)
  instructedCurrency        String?   @map("instructed_currency") @db.Char(3)
  /// Canonical JSON text as received (numbers exactly as sent).
  raw                       String

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  run         BankSyncRun     @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([transactionId, version])
  @@index([runId], map: "bank_transaction_versions_run_idx")
  @@map("bank_transaction_versions")
  @@schema("finance")
}

/// A TEST invoice (N3A-2b, doc 040 §9): one customer, currency and month; a line per hotel
/// agreement; everything printed is frozen in `snapshot`; its PDF stored create-only. Only kind TEST
/// (DB CHECK) — no live issuing. DB: append-only; total = Σ lines (checked at commit).
model Invoice {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial          BigInt   @unique
  kind            String
  number          String   @unique
  variableSymbol  String   @unique @map("variable_symbol")
  customerId      String   @map("customer_id") @db.Uuid
  customerVersion Int      @map("customer_version")
  periodMonth     DateTime @map("period_month") @db.Date
  issuedOn        DateTime @map("issued_on") @db.Date
  dueOn           DateTime @map("due_on") @db.Date
  currency        String   @db.Char(3)
  total           Decimal  @db.Decimal(19, 2)
  snapshot        Json
  pdfStorageKey   String   @unique @map("pdf_storage_key")
  pdfSha256       String   @map("pdf_sha256") @db.Char(64)
  issuedAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("issued_at") @db.Timestamptz(3)
  issuedBy        String   @map("issued_by") @db.Uuid
  issuedByName    String   @map("issued_by_name")
  requestId       String   @unique @map("request_id") @db.Uuid

  customer     CustomerVersion      @relation(fields: [customerId, customerVersion], references: [customerId, version], onDelete: Restrict)
  lines        InvoiceLine[]
  cancellation InvoiceCancellation?

  allocations PaymentAllocation[]

  @@index([customerId, periodMonth], map: "invoices_customer_idx")
  @@map("invoices")
  @@schema("finance")
}

/// One hotel agreement billed for the invoice's month: billed rooms × unit price (exact).
model InvoiceLine {
  invoiceId         String   @map("invoice_id") @db.Uuid
  lineNo            Int      @map("line_no")
  agreementId       String   @map("agreement_id") @db.Uuid
  agreementRevision BigInt   @map("agreement_revision")
  periodMonth       DateTime @map("period_month") @db.Date
  hotelId           String   @map("hotel_id") @db.Uuid
  hotelCode         String   @map("hotel_code")
  hotelName         String   @map("hotel_name")
  billedRooms       Int      @map("billed_rooms")
  unitPrice         Decimal  @map("unit_price") @db.Decimal(19, 2)
  amount            Decimal  @db.Decimal(19, 2)

  invoice   Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  agreement BillingAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  terms     AgreementVersion @relation(fields: [agreementRevision], references: [revision], onDelete: Restrict)

  @@id([invoiceId, lineNo])
  @@unique([invoiceId, agreementId])
  @@index([agreementId, periodMonth], map: "invoice_lines_agreement_idx")
  @@map("invoice_lines")
  @@schema("finance")
}

/// The cancellation of a TEST invoice (with a reason); the invoice itself never changes.
model InvoiceCancellation {
  invoiceId       String   @id @map("invoice_id") @db.Uuid
  reason          String
  cancelledAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     String   @map("cancelled_by") @db.Uuid
  cancelledByName String   @map("cancelled_by_name")
  requestId       String   @unique @map("request_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("invoice_cancellations")
  @@schema("finance")
}

/// An incoming payment (N3B-2, doc 041 §8): a credit bank transaction (BANK) or a simulated
/// statement entry outside production (SIMULATION), each recorded once (source, source_key).
/// `matchResult` = the automatic matching when recorded. DB: append-only.
model IncomingPayment {
  id                     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serial                 BigInt   @unique
  code                   String   @unique
  source                 String
  sourceKey              String   @map("source_key")
  environment            String
  bankTransactionId      String?  @map("bank_transaction_id") @db.Uuid
  bankTransactionVersion Int?     @map("bank_transaction_version")
  amount                 Decimal  @db.Decimal(19, 2)
  currency               String   @db.Char(3)
  bookedOn               DateTime @map("booked_on") @db.Date
  variableSymbol         String?  @map("variable_symbol")
  counterpartyName       String?  @map("counterparty_name")
  counterpartyAccount    String?  @map("counterparty_account")
  message                String?
  matchResult            String   @map("match_result")
  recordedAt             DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy             String   @map("recorded_by") @db.Uuid
  recordedByName         String   @map("recorded_by_name")

  bankTransaction BankTransaction?    @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]

  @@unique([source, sourceKey])
  @@index([variableSymbol], map: "incoming_payments_vs_idx")
  @@map("incoming_payments")
  @@schema("finance")
}

/// A part of a payment allocated to an invoice: AUTO (exact VS) or MANUAL (with a reason). Never
/// more than the payment or the invoice (DB). Append-only.
model PaymentAllocation {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  amount         Decimal  @db.Decimal(19, 2)
  kind           String
  reason         String?
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String   @map("recorded_by") @db.Uuid
  recordedByName String   @map("recorded_by_name")
  requestId      String?  @map("request_id") @db.Uuid

  payment IncomingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId], map: "payment_allocations_payment_idx")
  @@index([invoiceId], map: "payment_allocations_invoice_idx")
  @@map("payment_allocations")
  @@schema("finance")
}
