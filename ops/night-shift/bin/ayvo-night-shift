#!/usr/bin/env bash
set -euo pipefail
case "${1:-status}" in
  run-now)
    exec /opt/ayvo/night-shift/bin/run-night.sh
    ;;
  prepare|work|publish|check|status)
    exec /usr/bin/python3 /opt/ayvo/night-shift/bin/night_shift.py "${1:-status}"
    ;;
  *)
    echo 'usage: ayvo-night-shift {status|check|run-now|prepare|work|publish}' >&2
    exit 2
    ;;
esac
