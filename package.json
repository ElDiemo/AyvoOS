{
  "name": "ayvo-os",
  "private": true,
  "description": "AYVO OS \u2014 operating system for AYVO circular hotel amenity service",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @ayvo/api db:migrate",
    "infra:up": "docker compose -f docker/compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f docker/compose.yml --env-file .env down",
    "infra:config": "docker compose -f docker/compose.yml --env-file .env.example config --quiet",
    "deploy-dev:config": "docker compose -f deploy/dev/compose.yml --env-file .env.example --profile tools config --quiet",
    "label-artifacts": "pnpm --filter @ayvo/api build && node apps/api/scripts/label-artifacts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
