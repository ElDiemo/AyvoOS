# AYVO OS — example environment (DEV ONLY).
# Copy to .env and adjust. Never commit .env. Production values never live in this repo (ADR 0008).

# Environment marker: development | test | production (no staging yet — ADR 0008)
APP_ENV=development

# PostgreSQL (docker/compose.yml)
POSTGRES_USER=ayvo
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=ayvo_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ayvo:change-me-dev-only@localhost:5432/ayvo_dev

# Redis (docker/compose.yml) — non-authoritative cache/queue only (ADR 0010)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API (NestJS)
API_PORT=4000
# Base of the public QR URL printed on bottle labels: <base>/<token>. No trailing slash.
# Non-production processes refuse to start with the production QR host (ADR 0014).
PUBLIC_QR_BASE_URL=http://localhost:3000/q
# File storage for label artwork and print PDFs (relative paths resolve against apps/api).
# `local` is DEV-only: production refuses to start with it (ADR 0016).
FILE_STORAGE_DRIVER=local
FILE_STORAGE_DIR=../../var/storage
# S3 (production only, ADR 0032). Leave EMPTY on DEV. No endpoint or credential-profile fallback.
# Supply only the application identity, NEVER the separate backup identity, to the API.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_EXPECTED_BUCKET_OWNER=
# QR print settings - PROVISIONAL until the physical print/scan test (ADR 0014). Production has no
# default: without both (empty = not set) only our QR label operations are refused (ADR 0034).
# Candidate: 15 mm, Q. Error correction: L | M | Q | H. Outside production unset = 10 mm / Q.
LABEL_QR_MIN_SIZE_MM=10
LABEL_QR_ERROR_CORRECTION=Q
LABEL_ARTWORK_MAX_BYTES=10485760
# Workstation session lease in minutes (doc 026): only after it another user may take over (default 15).
STATION_SESSION_LEASE_MINUTES=15

# Identity and access (ADR 0022, doc 021). The API refuses to start without a provider:
# Native authentication. No external identity account or API key. Tests have their own fixture.
APP_PUBLIC_ORIGIN=http://localhost:3000
AUTH_PROVIDER=local
# Generate separately in each environment: openssl rand -hex 32. Back up outside the database.
AUTH_ENCRYPTION_KEY=
# Authentication mail, one explicit mode (doc 038):
#   google-relay  the approved Google Workspace SMTP relay (smtp-relay.gmail.com:587, STARTTLS,
#                 IPv4 allowlist of the server; no credentials — leave AUTH_SMTP_* unset)
#   smtp          authenticated submission: AUTH_SMTP_HOST, _PORT (465|587), _USER, _PASSWORD
# Existing, explicitly approved mail transport only; never silently sign up for another service.
AUTH_MAIL_DRIVER=google-relay
AUTH_MAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
# Sign-in rate limits (per client IP, Redis, fixed window).
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_LOGIN_MAX=30
AUTH_RATE_LIMIT_CALLBACK_MAX=30
AUTH_RATE_LIMIT_CALLBACK_FAILURES_MAX=10
# Proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs); empty locally.
TRUSTED_PROXY_CIDRS=
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Web (Next.js) — server-side URL used to reach the API
API_URL=http://localhost:4000
# The Finance unit (ADR 0039) — `pnpm --filter @ayvo/api start:finance`; serves /api/admin/finance/*.
FINANCE_API_URL=http://localhost:4010

# -----------------------------------------------------------------------------------------------
# DEV preview deployment — https://dev.ayvo.co (deploy/dev/compose.yml, scripts/deploy-dev.sh)
# SERVER-ONLY. Real values live only in the server env file, outside this repository
# (default /opt/ayvo/secrets/dev-preview.env, chmod 600). Never commit them. Local development
# ignores this section. The server env file must also set, with real values:
#   APP_ENV=development
#   POSTGRES_USER, POSTGRES_DB, and POSTGRES_PASSWORD (24+ chars of [A-Za-z0-9_-]:
#   `openssl rand -hex 32`). DATABASE_URL, REDIS_URL, API_URL are set by the Compose file.
#   AUTH_ENCRYPTION_KEY, AUTH_MAIL_DRIVER, AUTH_MAIL_FROM (+ AUTH_SMTP_* only for smtp; see above).
#   APP_PUBLIC_ORIGIN is set by the Compose file.
# -----------------------------------------------------------------------------------------------
DEV_DOMAIN=dev.ayvo.co
# Contact for the Let's Encrypt account used by Caddy for automatic TLS.
ACME_EMAIL=ops@example.com
# Access requires the Tailscale tailnet and native password + MFA application sign-in.
# No shared HTTP Basic Auth credentials are required.

# PPL CPL TEST environment (doc 029 §9). Both or neither; never commit real values. The API URL is
# fixed in code (https://api-dev.dhl.com/ecs/ppl/myapi2); there is no production connection yet.
PPL_TEST_CLIENT_ID=
PPL_TEST_CLIENT_SECRET=

# Key for carrier credentials entered in the administration (ADR 0027): 32 random bytes, base64,
# e.g. `openssl rand -base64 32`. Only in the server env file; without it nothing can be stored.
CARRIER_CREDENTIALS_KEY=

# Finance unit on the DEV preview (ADR 0039; scripts/deploy-finance-dev.sh). Server env file only:
#   FINANCE_DB_PASSWORD, FINANCE_DB_OWNER_PASSWORD  two different values, `openssl rand -hex 24`
#   FINANCE_SERVICE_TOKEN       `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
#   FINANCE_SERVICE_TOKEN_SHA256  `printf %s "$FINANCE_SERVICE_TOKEN" | sha256sum` (the API holds
#                                 only this hash; deploy the core first, then the Finance unit)
FINANCE_DB_PASSWORD=
FINANCE_DB_OWNER_PASSWORD=
FINANCE_SERVICE_TOKEN=
FINANCE_SERVICE_TOKEN_SHA256=
